+/* Put the player at x, y, z in the current block (PORT DEBUG, NOTES fix 57): lua_LoadChrPos's
+ * func_00273BE0(chr, v2 = (x, y, z, 0)). */
+static void des_player_place(ppu_context* ctx, uint32_t chr, const float xyz[3])
+{
+    PPU_MM_SNAP
+    ppu_context save = *ctx;
+    ctx->gpr[1] = (save.gpr[1] - 0x400) & ~0xFull;
+    const uint32_t v = (uint32_t)ctx->gpr[1] + 0x200;
+    for (int i = 0; i < 3; i++) { uint32_t w; memcpy(&w, &xyz[i], 4); vm_write32(v + 4 * i, w); }
+    vm_write32(v + 12, 0);
+    vm_raw_ld16(&ctx->vr[2], v);
+    ctx->gpr[3] = chr; ctx->lr = 0x0001B8D0; func_00273BE0(ctx); DRAIN_TRAMPOLINE(ctx);
+    *ctx = save;
+}
