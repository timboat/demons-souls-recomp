index 8507deb..a6a6edb 100644
--- a/libs/video/rsx_vertex_formats.h
+++ b/libs/video/rsx_vertex_formats.h
@@ -17,6 +17,20 @@ extern "C" {
 /* RSX vertex attribute type values (from NV4097_SET_VERTEX_DATA_ARRAY_FORMAT) */
 #define RSX_VERTEX_TYPE_NONE           0  /* disabled */
 #define RSX_VERTEX_TYPE_S1             1  /* signed normalized 16-bit */
+
+/* S1 (signed normalized 16-bit) to float the way the RSX does it: the legacy NV/OpenGL mapping
+ * (2c + 1) / 65535, not D3D's c / 32767. They differ by under 2^-15 except at c = 0, which is not
+ * zero on the RSX. Demon's Souls' rigid meshes (the player's shield, weapons) store all-zero skin
+ * weights; its skinning shader normalises the weights by their sum, so on the console each weight
+ * becomes 0.25 of the same bone, and with exact zeros the mesh collapsed to a point (NOTES fix 25).
+ * PS3_S1_D3D=1 = the old c / 32767. */
+#include <stdlib.h>
+static inline float rsx_s1_to_float(int c)
+{
+    static int d3d = -1;
+    if (d3d < 0) d3d = getenv("PS3_S1_D3D") ? 1 : 0;
+    return d3d ? (float)c / 32767.0f : ((float)c * 2.0f + 1.0f) / 65535.0f;
+}
 #define RSX_VERTEX_TYPE_F              2  /* float32 */
 #define RSX_VERTEX_TYPE_SF             3  /* half-float (float16) */
 #define RSX_VERTEX_TYPE_UB             4  /* unsigned byte */
