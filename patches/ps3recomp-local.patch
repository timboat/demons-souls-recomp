+    const int x = area.left + ((area.right - area.left) - W) / 2;
+    const int y = area.top + ((area.bottom - area.top) - H) / 2;
+
+    HWND hwnd = CreateWindowExW(WS_EX_TOPMOST | WS_EX_DLGMODALFRAME, L"ps3recomp_osk",
+                                L"Enter text", WS_POPUP | WS_CAPTION | WS_SYSMENU,
