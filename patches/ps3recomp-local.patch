+/* Bring the text box up; 0 if it cannot be shown (the caller answers at once). */
+static int osk_open_host_window(const CellOskDialogChar* prompt, const CellOskDialogChar* init,
+                                u32 limit)
+{
+    u32 i;
+    for (i = 0; i < CELL_OSK_MAX_TEXT_LENGTH && prompt && prompt[i]; i++) s_osk_prompt[i] = prompt[i];
+    s_osk_prompt[i] = 0;
+    for (i = 0; i < CELL_OSK_MAX_TEXT_LENGTH && init && init[i]; i++) s_osk_init[i] = init[i];
+    s_osk_init[i] = 0;
+    s_osk_limit = limit;
+    InterlockedExchange(&g_osk_host_window_open, 1);
+    HANDLE t = CreateThread(NULL, 0, osk_window_thread, NULL, 0, NULL);
+    if (!t) { InterlockedExchange(&g_osk_host_window_open, 0); return 0; }
+    CloseHandle(t);
+    return 1;
+}
+
+static void osk_close_host_window(void)
+{
+    HWND h = s_osk_hwnd;
+    if (h) PostMessageW(h, WM_CLOSE, 0, 0);
+}
+#else
+static int osk_open_host_window(const CellOskDialogChar* prompt, const CellOskDialogChar* init,
+                                u32 limit)
+{ (void)prompt; (void)init; (void)limit; return 0; }
+static void osk_close_host_window(void) {}
+#endif
