+        return 0;
+    /* The slot layout is a pure function of the mask. */
+    u64 h = ld_vc_hash((const u8*)&layout->mask, sizeof(layout->mask), prim);
+    struct {
+        u32 base_offset, base_index, divider, restart_en, restart_val;
+        u32 n_arr, n_idx;
+        rsx_dsp_index_array ia;
+    } hdr;
+    memset(&hdr, 0, sizeof(hdr));
+    hdr.base_offset = rsx_dsp_vertex_data_base_offset(&g.rsx);
+    hdr.base_index = rsx_dsp_vertex_data_base_index(&g.rsx);
+    hdr.divider = rsx_dsp_reg(&g.rsx, 0x1FC0);
+    hdr.n_arr = dc.n_arr;
+    hdr.n_idx = dc.n_idx;
+    if (dc.n_idx) {
+        rsx_dsp_get_index_array(&g.rsx, &hdr.ia);
+        static int no_restart = -1;
+        if (no_restart < 0) no_restart = getenv("RSX_NO_RESTART") ? 1 : 0;
+        hdr.restart_en = !no_restart &&
