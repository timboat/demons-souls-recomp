+        hdr.restart_val = rsx_dsp_restart_index(&g.rsx);
+    }
+    h = ld_vc_hash((const u8*)&hdr, sizeof(hdr), h);
+    for (u32 slot = 0; slot < layout->count; slot++) {
+        struct { rsx_dsp_vertex_attr a; float def[4]; } at;
+        memset(&at, 0, sizeof(at));
+        rsx_dsp_get_vertex_attr(&g.rsx, layout->attrs[slot], &at.a);
+        rsx_dsp_vertex_default(&g.rsx, layout->attrs[slot], at.def);
+        h = ld_vc_hash((const u8*)&at, sizeof(at), h);
+    }
+    if (dc.n_arr)
+        h = ld_vc_hash((const u8*)dc.arr, (size_t)dc.n_arr * sizeof(dc.arr[0]), h);
+    if (dc.n_idx) {
+        h = ld_vc_hash((const u8*)dc.idx, (size_t)dc.n_idx * sizeof(dc.idx[0]), h);
+        const u32 esz = hdr.ia.is_u32 ? 4u : 2u;
+        for (u32 r = 0; r < dc.n_idx; r++) {
+            const u64 start = (u64)hdr.ia.offset + (u64)dc.idx[r].first * esz;
+            const u64 bytes = (u64)dc.idx[r].count * esz;
+            if (!bytes) continue;
+            if (start + bytes > 0x100000000ull) return 0;
+            const u8* ip = guest_ptr(hdr.ia.location, (u32)start, (u32)bytes);
+            if (!ip) return 0;
+            g_rs_key_b += bytes;
+            h = ld_vc_hash(ip, (size_t)bytes, h);
+        }
