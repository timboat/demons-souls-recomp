+static int pad_pulse(PadPulse* p, unsigned long long now)
+{
+    if (now < p->down_until) return 1;
+    if (now < p->up_until) return 0;
+    if (p->pending > 0) { p->pending--; p->down_until = now + 70; p->up_until = now + 120; return 1; }
+    return 0;
+}
