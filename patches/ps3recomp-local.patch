+int spu_taskset_is_down_scan(uint32_t ea, uint64_t gen)
+{
+    int down = 0;
+    const int hi = s_ts_down_hi;
+    for (int i = 0; i < hi; i++) if (s_ts_down[i] == ea) { down = 1; break; }
+    { struct spu_ts_memo* const m = &g_spu_ts_memo; m->ea = ea; m->gen = gen; m->down = down; }
