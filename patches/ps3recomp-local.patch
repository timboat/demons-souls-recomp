diff --git a/libs/codec/sail_engine.c b/libs/codec/sail_engine.c
new file mode 100644
index 0000000..28a0efd
--- /dev/null
+++ b/libs/codec/sail_engine.c
@@ -0,0 +1,483 @@
+/*
+ * ps3recomp - host playback engine behind cellSail (Demon's Souls NOTES fix 71)
+ *
+ * Two threads per playing movie:
+ *   reader  -- reads the PAMF in 64 KB chunks from the first pack, demuxes it
+ *              (sail_mpegps) into a queue of coded pictures and a PCM ring;
+ *   decoder -- runs the pictures through vdec_mf (Media Foundation MPEG-2) and
+ *              converts each displayed picture to RGBA into a ring of frames.
+ * The title's threads only copy: a due frame into its graphics buffer
+ * (sail_engine_take_frame) and samples into its sound buffer (sail_engine_pull_pcm).
+ * Every queue is bounded, so a stalled title stalls the threads, not memory.
+ *
+ * Display timestamps: an MPEG-2 PAMF carries one PTS per GOP and the video is
+ * constant-rate, so frame n is shown at start_pts + n * frame_ticks (the
+ * sequence header's rate: 3003 ticks at 29.97 fps), the same grid the LPCM
+ * (sample k at start_pts + k * 90000 / 48000) is on.
+ */
+#include "sail_engine.h"
+#include "sail_mpegps.h"
+#include "vdec_mf.h"
+#include "../guest_struct.h"   /* vm_memcpy_to */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* The engine runs on every host: on Windows over Win32 and Media Foundation,
+ * elsewhere over the POSIX forms of the same calls (runtime/platform/
+ * win32_compat.h) and libavcodec (vdec_mf.c's non-Windows half). Without a
+ * decoder, sail_engine_decoder_available() is 0 and cellSail keeps its
+ * no-playback path. */
+#if 1
+#ifdef _WIN32
+#include <windows.h>
+#include <objbase.h>   /* CoInitializeEx */
+#else
+#include "../../runtime/platform/win32_compat.h"
+#define COINIT_MULTITHREADED 0
+#define CoInitializeEx(r, f) ((void)(r), (void)(f))   /* COM is Media Foundation's alone */
+#define CoUninitialize()     ((void)0)
+#define _fseeki64(f, o, w)   fseeko((f), (off_t)(o), (w))   /* 64-bit seek */
+#endif
+
+#define SAIL_FRAMES      6                 /* decoded RGBA frames held (3.6 MB each at 720p) */
+#define SAIL_AU_MAX      240               /* coded pictures queued (8 s) */
+#define SAIL_AU_BYTES    (24u << 20)
+#define SAIL_PCM_SECONDS 4
+
+typedef struct { uint8_t* data; size_t n; } sail_au;
+
+struct sail_engine {
+    sail_movie_info mi;
+    CRITICAL_SECTION lk;
+    CONDITION_VARIABLE cv;          /* any queue changed / abort */
+    HANDLE th_read, th_dec;
+    volatile LONG abort;
+
+    /* reader -> decoder */
+    sail_au au[SAIL_AU_MAX];
+    int au_head, au_count;
+    size_t au_bytes;
+    int read_eof;
+
+    /* decoder -> title */
+    uint8_t* frame[SAIL_FRAMES];
+    int64_t frame_pts[SAIL_FRAMES];
+    int fr_head, fr_count;
+    int64_t next_pts;               /* display PTS of the next decoded frame */
+    int dec_done;
+    int dec_failed;   /* the decoder would not open: the movie ends at once */
+    int frame_ticks;
+    int w, h;
+
+    /* reader -> title (LPCM, big-endian s16 bytes as stored) */
+    uint8_t* pcm;
+    size_t pcm_cap, pcm_head, pcm_count;
+
+    sail_ps* ps;
+    unsigned shown, dropped, underruns;
+};
+
+/* ---------------------------------------------------------------------------
+ * Header
+ * -----------------------------------------------------------------------*/
+static uint32_t be32(const uint8_t* p) { return (uint32_t)p[0] << 24 | (uint32_t)p[1] << 16 | (uint32_t)p[2] << 8 | p[3]; }
+static uint32_t be16(const uint8_t* p) { return (uint32_t)p[0] << 8 | p[1]; }
+
+int sail_movie_probe(const char* host_path, sail_movie_info* out, uint8_t* hdr2048)
+{
+    memset(out, 0, sizeof *out);
+    uint8_t h[2048];
+    FILE* f = fopen(host_path, "rb");
+    if (!f) return 0;
+    const size_t got = fread(h, 1, sizeof h, f);
+    fclose(f);
+    if (hdr2048) memcpy(hdr2048, h, got < sizeof h ? got : sizeof h);
+    if (got < sizeof h || memcmp(h, "PAMF", 4)) return 0;
+    snprintf(out->path, sizeof out->path, "%s", host_path);
+    out->data_off  = (uint64_t)be32(h + 0x08) * 2048u;
+    out->data_size = (uint64_t)be32(h + 0x0C) * 2048u;
+    out->start_pts = ((int64_t)be16(h + 0x56) << 32) | be32(h + 0x58);
+    out->end_pts   = ((int64_t)be16(h + 0x5C) << 32) | be32(h + 0x5E);
+    out->width = 1280; out->height = 720;
+    int video = 0;
+    const int n = h[0x6D];
+    for (int i = 0; i < n && 0x88 + i * 0x30 + 0x30 <= 2048; i++) {
+        const uint8_t* e = h + 0x88 + i * 0x30;
+        if (e[0] == 0x02 && !video) {                        /* MPEG-2 video */
+            video = 1;
+            const int w = (int)be16(e + 0x1C), hh = (int)be16(e + 0x1E);   /* 0x19/0x1B: macroblocks */
+            if (w > 0 && w <= 1920 && hh > 0 && hh <= 1080) { out->width = w; out->height = hh; }
+        } else if (e[0] == 0x80 && !out->audio_channels) {   /* LPCM */
+            out->audio_channels = e[0x12];
+            out->audio_subid = e[5];
+        }
+    }
+    if (out->audio_channels < 0 || out->audio_channels > 8) out->audio_channels = 0;
+    return video && out->data_off >= 2048;
+}
+
+int sail_engine_decoder_available(void) { return vdec_mf_probe(); }
+
+/* ---------------------------------------------------------------------------
+ * Reader thread
+ * -----------------------------------------------------------------------*/
+static void sail_on_au(void* user, const uint8_t* au, size_t n, int64_t pts90k)
+{
+    (void)pts90k;   /* one PTS per GOP: display times come from the frame count */
+    sail_engine* e = (sail_engine*)user;
+    uint8_t* copy = (uint8_t*)malloc(n);
+    if (!copy) return;
+    memcpy(copy, au, n);
+    EnterCriticalSection(&e->lk);
+    while (!e->abort && !e->dec_failed && (e->au_count == SAIL_AU_MAX || e->au_bytes + n > SAIL_AU_BYTES))
+        SleepConditionVariableCS(&e->cv, &e->lk, INFINITE);
+    if (e->abort || e->dec_failed) { LeaveCriticalSection(&e->lk); free(copy); return; }
+    const int slot = (e->au_head + e->au_count) % SAIL_AU_MAX;
+    e->au[slot].data = copy; e->au[slot].n = n;
+    e->au_count++; e->au_bytes += n;
+    WakeAllConditionVariable(&e->cv);
+    LeaveCriticalSection(&e->lk);
+}
+
+static void sail_on_pcm(void* user, const uint8_t* pcm, size_t n)
+{
+    sail_engine* e = (sail_engine*)user;
+    if (!e->pcm) return;
+    while (n) {
+        EnterCriticalSection(&e->lk);
+        while (!e->abort && e->pcm_count == e->pcm_cap)
+            SleepConditionVariableCS(&e->cv, &e->lk, INFINITE);
+        if (e->abort) { LeaveCriticalSection(&e->lk); return; }
+        size_t room = e->pcm_cap - e->pcm_count, take = n < room ? n : room;
+        for (size_t i = 0; i < take; i++)
+            e->pcm[(e->pcm_head + e->pcm_count + i) % e->pcm_cap] = pcm[i];
+        e->pcm_count += take; pcm += take; n -= take;
+        WakeAllConditionVariable(&e->cv);
+        LeaveCriticalSection(&e->lk);
+    }
+}
+
+static DWORD WINAPI sail_reader(LPVOID arg)
+{
+    sail_engine* e = (sail_engine*)arg;
+    FILE* f = fopen(e->mi.path, "rb");
+    if (f && _fseeki64(f, (long long)e->mi.data_off, SEEK_SET) == 0) {
+        enum { CHUNK = 64 * 1024 };
+        uint8_t* buf = (uint8_t*)malloc(CHUNK);
+        uint64_t left = e->mi.data_size ? e->mi.data_size : ~0ull;
+        while (buf && !e->abort && left) {
+            const size_t want = left < CHUNK ? (size_t)left : CHUNK;
+            const size_t got = fread(buf, 1, want, f);
+            if (got < 2048) break;
+            if (sail_ps_feed(e->ps, buf, got - got % 2048) < 0) break;
+            left -= got;
+        }
+        if (!e->abort) sail_ps_flush(e->ps);
+        free(buf);
+    }
+    if (f) fclose(f);
+    EnterCriticalSection(&e->lk);
+    e->read_eof = 1;
+    WakeAllConditionVariable(&e->cv);
+    LeaveCriticalSection(&e->lk);
+    return 0;
+}
+
+/* ---------------------------------------------------------------------------
+ * Decoder thread
+ * -----------------------------------------------------------------------*/
+static inline uint8_t clamp8(int v) { return (uint8_t)(v < 0 ? 0 : v > 255 ? 255 : v); }
+
+/* I420 (limited range, BT.709) -> R,G,B,A bytes, the layout the title reads with
+ * texture remap 0xA993 (alpha forced). Same coefficients as vdec_store_picture. */
+static void sail_i420_to_rgba(uint8_t* dst, int w, int h, const uint8_t* py, const uint8_t* pu,
+                              const uint8_t* pv, int ys, int cs)
+{
+    const int cy = 76309, rv = 117489, gu = 13954, gv = 34925, bu = 138438;
+    for (int y = 0; y < h; y++) {
+        const uint8_t* ly = py + (size_t)y * ys;
+        const uint8_t* lu = pu + (size_t)(y / 2) * cs;
+        const uint8_t* lv = pv + (size_t)(y / 2) * cs;
+        uint8_t* o = dst + (size_t)y * w * 4;
+        for (int x = 0; x < w; x++) {
+            const int yy = (ly[x] - 16) * cy + 32768, u = lu[x >> 1] - 128, v = lv[x >> 1] - 128;
+            o[0] = clamp8((yy + rv * v) >> 16);
+            o[1] = clamp8((yy - gu * u - gv * v) >> 16);
+            o[2] = clamp8((yy + bu * u) >> 16);
+            o[3] = 0xFF;
+            o += 4;
+        }
+    }
+}
+
+static void sail_on_frame(void* user, const uint8_t* y, const uint8_t* u, const uint8_t* v,
+                          int ystride, int cstride, int w, int h, int64_t pts90k)
+{
+    (void)pts90k;
+    sail_engine* e = (sail_engine*)user;
+    if (w != e->w || h != e->h) {   /* the frames are sized for the header's picture */
+        static int said;
+        if (!said) { said = 1; fprintf(stderr, "[sail] decoded %dx%d, expected %dx%d -- frame skipped\n",
+                                       w, h, e->w, e->h); }
+        return;
+    }
+    EnterCriticalSection(&e->lk);
+    while (!e->abort && e->fr_count == SAIL_FRAMES)
+        SleepConditionVariableCS(&e->cv, &e->lk, INFINITE);
+    if (e->abort) { LeaveCriticalSection(&e->lk); return; }
+    const int slot = (e->fr_head + e->fr_count) % SAIL_FRAMES;
+    LeaveCriticalSection(&e->lk);
+    /* The slot is past the readers' end and only this thread fills slots. */
+    sail_i420_to_rgba(e->frame[slot], w, h, y, u, v, ystride, cstride);
+    EnterCriticalSection(&e->lk);
+    e->frame_pts[slot] = e->next_pts;
+    e->next_pts += e->frame_ticks;
+    e->fr_count++;
+    WakeAllConditionVariable(&e->cv);
+    LeaveCriticalSection(&e->lk);
+}
+
+static DWORD WINAPI sail_decoder(LPVOID arg)
+{
+    sail_engine* e = (sail_engine*)arg;
+    CoInitializeEx(NULL, COINIT_MULTITHREADED);   /* Media Foundation needs COM on this thread */
+    vdec_mf* d = NULL;
+    for (;;) {
+        sail_au au = { NULL, 0 };
+        EnterCriticalSection(&e->lk);
+        while (!e->abort && !e->au_count && !e->read_eof)
+            SleepConditionVariableCS(&e->cv, &e->lk, INFINITE);
+        if (!e->abort && e->au_count) {
+            au = e->au[e->au_head];
+            e->au_head = (e->au_head + 1) % SAIL_AU_MAX;
+            e->au_count--; e->au_bytes -= au.n;
+            WakeAllConditionVariable(&e->cv);
+        }
+        const int stop = e->abort || (!au.data && e->read_eof);
+        LeaveCriticalSection(&e->lk);
+        if (au.data) {
+            if (!d) {   /* the sequence header is known once the first picture is demuxed */
+                size_t sn = 0;
+                const uint8_t* sh = sail_ps_seq_header(e->ps, &sn);
+                const int frc = sail_ps_frame_rate_code(e->ps);
+                static const int ticks[9] = { 3003, 3754, 3750, 3600, 3003, 3000, 1800, 1502, 1500 };
+                EnterCriticalSection(&e->lk);
+                e->frame_ticks = (frc >= 1 && frc <= 8) ? ticks[frc] : 3003;
+                LeaveCriticalSection(&e->lk);
+                d = vdec_mf_open(e->w, e->h, sh, sn, frc);
+                if (!d) {
+                    fprintf(stderr, "[sail] MPEG-2 decoder open failed -- movie ends\n");
+                    free(au.data);
+                    EnterCriticalSection(&e->lk);
+                    e->dec_failed = 1;
+                    WakeAllConditionVariable(&e->cv);
+                    LeaveCriticalSection(&e->lk);
+                    break;
+                }
+            }
+            vdec_mf_decode(d, au.data, au.n, -1, sail_on_frame, e);
+            free(au.data);
+        }
+        if (stop) break;
+    }
+    if (d) {
+        if (!e->abort) vdec_mf_drain(d, sail_on_frame, e);
+        vdec_mf_close(d);
+    }
+    EnterCriticalSection(&e->lk);
+    e->dec_done = 1;
+    WakeAllConditionVariable(&e->cv);
+    LeaveCriticalSection(&e->lk);
+    CoUninitialize();
+    return 0;
+}
+
+/* ---------------------------------------------------------------------------
+ * Lifetime
+ * -----------------------------------------------------------------------*/
+sail_engine* sail_engine_create(const sail_movie_info* mi)
+{
+    sail_engine* e = (sail_engine*)calloc(1, sizeof *e);
+    if (!e) return NULL;
+    e->mi = *mi;
+    e->w = mi->width; e->h = mi->height;
+    e->frame_ticks = 3003;
+    InitializeCriticalSection(&e->lk);
+    InitializeConditionVariable(&e->cv);
+    for (int i = 0; i < SAIL_FRAMES; i++) {
+        e->frame[i] = (uint8_t*)malloc((size_t)e->w * e->h * 4);
+        if (!e->frame[i]) { sail_engine_destroy(e); return NULL; }
+    }
+    if (mi->audio_channels > 0) {
+        e->pcm_cap = (size_t)48000 * SAIL_PCM_SECONDS * mi->audio_channels * 2;
+        e->pcm = (uint8_t*)malloc(e->pcm_cap);
+    }
+    return e;
+}
+
+static void sail_join(sail_engine* e)
+{
+    if (!e->th_read && !e->th_dec) return;
+    EnterCriticalSection(&e->lk);
+    InterlockedExchange(&e->abort, 1);
+    WakeAllConditionVariable(&e->cv);
+    LeaveCriticalSection(&e->lk);
+    HANDLE hs[2]; DWORD n = 0;
+    if (e->th_read) hs[n++] = e->th_read;
+    if (e->th_dec) hs[n++] = e->th_dec;
+    if (WaitForMultipleObjects(n, hs, TRUE, 3000) == WAIT_TIMEOUT)
+        fprintf(stderr, "[sail] playback threads did not stop within 3 s\n");
+    for (DWORD i = 0; i < n; i++) CloseHandle(hs[i]);
+    e->th_read = e->th_dec = NULL;
+    for (int i = 0; i < e->au_count; i++) free(e->au[(e->au_head + i) % SAIL_AU_MAX].data);
+    e->au_head = e->au_count = 0; e->au_bytes = 0;
+    if (e->ps) { sail_ps_destroy(e->ps); e->ps = NULL; }
+}
+
+void sail_engine_start(sail_engine* e)
+{
+    if (!e) return;
+    sail_join(e);
+    e->abort = 0;
+    e->read_eof = 0; e->dec_done = 0; e->dec_failed = 0;
+    e->fr_head = e->fr_count = 0;
+    e->next_pts = e->mi.start_pts;
+    e->pcm_head = e->pcm_count = 0;
+    sail_ps_cb cb = { sail_on_au, sail_on_pcm, e };
+    e->ps = sail_ps_create(&cb, e->mi.audio_subid ? e->mi.audio_subid : 0x40);
+    if (!e->ps) { e->read_eof = e->dec_done = 1; return; }
+    e->th_read = CreateThread(NULL, 0, sail_reader, e, 0, NULL);
+    e->th_dec = CreateThread(NULL, 0, sail_decoder, e, 0, NULL);
+    if (e->th_read) SetThreadDescription(e->th_read, L"sail_reader");
+    if (e->th_dec) SetThreadDescription(e->th_dec, L"sail_decoder");
+}
+
+void sail_engine_stop(sail_engine* e)
+{
+    if (!e) return;
+    sail_join(e);
+    e->fr_head = e->fr_count = 0;
+    e->pcm_head = e->pcm_count = 0;
+    e->read_eof = e->dec_done = 1;
+}
+
+void sail_engine_destroy(sail_engine* e)
+{
+    if (!e) return;
+    sail_join(e);
+    for (int i = 0; i < SAIL_FRAMES; i++) free(e->frame[i]);
+    free(e->pcm);
+    DeleteCriticalSection(&e->lk);
+    free(e);
+}
+
+/* ---------------------------------------------------------------------------
+ * Title side
+ * -----------------------------------------------------------------------*/
+int sail_engine_take_frame(sail_engine* e, int64_t clock90k, uint32_t dst_ea, uint32_t pitch,
+                           int64_t* pts_out)
+{
+    if (!e) return 0;
+    EnterCriticalSection(&e->lk);
+    /* Late frames go when a newer one is already decoded. */
+    while (e->fr_count >= 2 && e->frame_pts[(e->fr_head + 1) % SAIL_FRAMES] <= clock90k) {
+        e->fr_head = (e->fr_head + 1) % SAIL_FRAMES;
+        e->fr_count--; e->dropped++;
+        WakeAllConditionVariable(&e->cv);
+    }
+    if (!e->fr_count || e->frame_pts[e->fr_head] > clock90k + e->frame_ticks / 2) {
+        LeaveCriticalSection(&e->lk);
+        return 0;
+    }
+    const int slot = e->fr_head;
+    const int64_t pts = e->frame_pts[slot];
+    LeaveCriticalSection(&e->lk);
+    /* The decoder never writes the head slot, so the copy needs no lock. */
+    const uint8_t* src = e->frame[slot];
+    const uint32_t row = (uint32_t)e->w * 4;
+    if (pitch == row) vm_memcpy_to(dst_ea, src, (size_t)row * e->h);
+    else for (int y = 0; y < e->h; y++) vm_memcpy_to(dst_ea + (uint32_t)y * pitch, src + (size_t)y * row, row);
+    EnterCriticalSection(&e->lk);
+    e->fr_head = (e->fr_head + 1) % SAIL_FRAMES;
+    e->fr_count--; e->shown++;
+    WakeAllConditionVariable(&e->cv);
+    LeaveCriticalSection(&e->lk);
+    if (pts_out) *pts_out = pts;
+    return 1;
+}
+
+int sail_engine_pull_pcm(sail_engine* e, int16_t* out, int frames)
+{
+    const int ch = e ? e->mi.audio_channels : 0;
+    if (!e || ch <= 0 || !e->pcm) { if (out && ch > 0) memset(out, 0, (size_t)frames * ch * 2); return 0; }
+    const size_t want = (size_t)frames * ch * 2;
+    EnterCriticalSection(&e->lk);
+    size_t take = e->pcm_count < want ? e->pcm_count : want;
+    take -= take % ((size_t)ch * 2);
+    for (size_t i = 0; i < take; i += 2) {
+        const uint8_t hi = e->pcm[(e->pcm_head + i) % e->pcm_cap];
+        const uint8_t lo = e->pcm[(e->pcm_head + i + 1) % e->pcm_cap];
+        out[i / 2] = (int16_t)(uint16_t)(hi << 8 | lo);   /* LPCM is big-endian */
+    }
+    e->pcm_head = (e->pcm_head + take) % e->pcm_cap;
+    e->pcm_count -= take;
+    if (take < want && !(e->read_eof && !e->pcm_count)) e->underruns++;
+    WakeAllConditionVariable(&e->cv);
+    LeaveCriticalSection(&e->lk);
+    if (take < want) memset((uint8_t*)out + take, 0, want - take);
+    return (int)(take / ((size_t)ch * 2));
+}
+
+int sail_engine_finished(sail_engine* e)
+{
+    if (!e) return 1;
+    EnterCriticalSection(&e->lk);
+    /* The audio tail matters: the title closes the stream on EOS, and an LPCM
+     * track a little longer than the pictures was cut off. Less than one sample
+     * frame left counts as drained. */
+    const size_t fb = (size_t)(e->mi.audio_channels > 0 ? e->mi.audio_channels : 1) * 2;
+    const int done = e->dec_failed ||
+                     (e->read_eof && e->dec_done && !e->fr_count && (!e->pcm || e->pcm_count < fb));
+    LeaveCriticalSection(&e->lk);
+    return done;
+}
+
+int sail_engine_video_done(sail_engine* e)
+{
+    if (!e) return 1;
+    EnterCriticalSection(&e->lk);
+    const int done = e->dec_failed || (e->read_eof && e->dec_done && !e->fr_count);
+    LeaveCriticalSection(&e->lk);
+    return done;
+}
+
+int sail_engine_frame_ticks(const sail_engine* e) { return e ? e->frame_ticks : 3003; }
+
+void sail_engine_stats(sail_engine* e, unsigned* shown, unsigned* dropped, unsigned* queued,
+                       unsigned* pcm_ms, unsigned* underruns)
+{
+    EnterCriticalSection(&e->lk);
+    *shown = e->shown; *dropped = e->dropped; *queued = (unsigned)e->fr_count;
+    *pcm_ms = e->mi.audio_channels ? (unsigned)(e->pcm_count / ((size_t)e->mi.audio_channels * 2) / 48) : 0;
+    *underruns = e->underruns;
+    LeaveCriticalSection(&e->lk);
+}
+
+#else   /* unused: kept for a build that leaves the engine out */
+
+int sail_movie_probe(const char* p, sail_movie_info* o, uint8_t* h) { (void)p; (void)h; memset(o, 0, sizeof *o); return 0; }
+int sail_engine_decoder_available(void) { return 0; }
+sail_engine* sail_engine_create(const sail_movie_info* mi) { (void)mi; return NULL; }
+void sail_engine_start(sail_engine* e) { (void)e; }
+void sail_engine_stop(sail_engine* e) { (void)e; }
+void sail_engine_destroy(sail_engine* e) { (void)e; }
+int sail_engine_take_frame(sail_engine* e, int64_t c, uint32_t d, uint32_t p, int64_t* o) { (void)e; (void)c; (void)d; (void)p; (void)o; return 0; }
+int sail_engine_pull_pcm(sail_engine* e, int16_t* o, int f) { (void)e; (void)o; (void)f; return 0; }
+int sail_engine_finished(sail_engine* e) { (void)e; return 1; }
+int sail_engine_video_done(sail_engine* e) { (void)e; return 1; }
+int sail_engine_frame_ticks(const sail_engine* e) { (void)e; return 3003; }
+void sail_engine_stats(sail_engine* e, unsigned* a, unsigned* b, unsigned* c, unsigned* d, unsigned* f) { (void)e; *a = *b = *c = *d = *f = 0; }
+
+#endif
diff --git a/libs/codec/sail_engine.h b/libs/codec/sail_engine.h
new file mode 100644
index 0000000..6776311
--- /dev/null
+++ b/libs/codec/sail_engine.h
@@ -0,0 +1,73 @@
+/*
+ * ps3recomp - host playback engine behind cellSail (Demon's Souls NOTES fix 71)
+ *
+ * Plays a PAMF movie (MPEG-2 video + LPCM audio, the PS3 SDK's movie container):
+ * a reader thread demuxes the program stream (sail_mpegps), a decoder thread runs
+ * the pictures through the Media Foundation MPEG-2 decoder (vdec_mf) into a small
+ * ring of RGBA frames, and the LPCM bytes go into a PCM ring. cellSail.c hands the
+ * frames to the title's graphics adapter as they come due on a clock, and the PCM
+ * to its sound adapter as the title pulls it. No guest memory is touched here
+ * except through sail_engine_take_frame's destination.
+ */
+#ifndef PS3RECOMP_SAIL_ENGINE_H
+#define PS3RECOMP_SAIL_ENGINE_H
+
+#include <stdint.h>
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct sail_movie_info {
+    char     path[512];       /* host path of the .pam */
+    uint64_t data_off;        /* first pack (header be32 0x08 * 2048) */
+    uint64_t data_size;
+    int64_t  start_pts;       /* 90 kHz (header 0x56..) */
+    int64_t  end_pts;
+    int      width, height;   /* from the stream table (1280x720 here) */
+    int      audio_channels;  /* first LPCM stream's channels; 0 = no audio */
+    int      audio_subid;     /* its private-stream-1 sub id (0x40) */
+} sail_movie_info;
+
+/* Read a PAMF header from `host_path` (the first 2048 bytes are copied to hdr when
+ * hdr != NULL). 1 = a PAMF this engine can play, 0 = not (other container / codec). */
+int sail_movie_probe(const char* host_path, sail_movie_info* out, uint8_t* hdr2048);
+
+/* Whether a decoder for the movies exists on this machine (cached). */
+int sail_engine_decoder_available(void);
+
+typedef struct sail_engine sail_engine;
+
+sail_engine* sail_engine_create(const sail_movie_info* mi);
+/* (Re)start from the first frame: joins running threads, clears every queue. */
+void sail_engine_start(sail_engine* e);
+/* Abort the threads (fast) and drop everything queued; sail_engine_start rewinds. */
+void sail_engine_stop(sail_engine* e);
+void sail_engine_destroy(sail_engine* e);
+
+/* The next frame due at `clock90k`: frames more than one frame late are dropped
+ * (when a newer one is ready), and one due within half a frame is copied as
+ * tightly packed RGBA rows (`pitch` bytes apart) to guest memory at dst_ea.
+ * Returns 1 with its PTS, 0 when none is due yet. */
+int sail_engine_take_frame(sail_engine* e, int64_t clock90k, uint32_t dst_ea, uint32_t pitch,
+                           int64_t* pts_out);
+/* Up to `frames` interleaved sample frames (channels from the movie) as host s16;
+ * returns how many were real -- the rest of `out` is filled with silence. */
+int sail_engine_pull_pcm(sail_engine* e, int16_t* out, int frames);
+/* Everything demuxed, decoded and handed out, and the audio drained -- or the
+ * decoder failed to open (nothing will ever come). */
+int sail_engine_finished(sail_engine* e);
+/* Every video frame handed out (audio may still be buffered). */
+int sail_engine_video_done(sail_engine* e);
+/* Frame duration in 90 kHz ticks (3003 for 29.97 fps). */
+int sail_engine_frame_ticks(const sail_engine* e);
+/* Counters for the PS3_SAIL_LOG line. */
+void sail_engine_stats(sail_engine* e, unsigned* shown, unsigned* dropped, unsigned* queued,
+                       unsigned* pcm_ms, unsigned* underruns);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PS3RECOMP_SAIL_ENGINE_H */
diff --git a/libs/codec/sail_mpegps.c b/libs/codec/sail_mpegps.c
new file mode 100644
index 0000000..009ab1f
--- /dev/null
+++ b/libs/codec/sail_mpegps.c
@@ -0,0 +1,368 @@
+/*
+ * ps3recomp - MPEG-2 Program Stream demuxer for cellSail's PAMF player
+ *
+ * Demon's Souls NOTES fix 71. See sail_mpegps.h for the contract. Layout of
+ * the game's PAMF payload (checked on ds_title.pam / ds_opening.pam):
+ *
+ *   pack  00 00 01 BA, 14-byte MPEG-2 pack header (+ b13 & 7 stuffing),
+ *         every pack exactly 2048 bytes
+ *   BB    system header, once per GOP                       -> skipped
+ *   BF    private stream 2, per-GOP picture size table     -> skipped (we
+ *         split on start codes, which needs no trust in that table)
+ *   BE    padding                                           -> skipped
+ *   E0    video PES: 81 C1 + 13-byte header with PTS/DTS on the first PES of
+ *         a GOP, 81 00 00 everywhere else; payload = MPEG-2 ES
+ *   BD    private stream 1: payload "40 31 HH LL" + LPCM (2016 or 2013 bytes)
+ *
+ * Only helpers named sail_ps_* live here: gen_hle_nids.py registers every
+ * non-static cell* / sys* / sce* function it finds, so none may appear.
+ */
+
+#include "sail_mpegps.h"
+
+#include <stdlib.h>
+#include <string.h>
+
+#define PS_PACK_SIZE   2048u
+/* A 1280x720 MPEG-2 picture at 30 Mbit/s is ~125 KB, an I picture rarely
+ * above 1 MB. Anything near this cap means we lost the picture start codes;
+ * drop the buffer rather than grow without bound on a corrupt file. */
+#define PS_AU_MAX      (16u * 1024u * 1024u)
+#define PS_SEQ_MAX     1024u
+#define PS_NO_OFF      ((size_t)-1)
+
+struct sail_ps {
+    sail_ps_cb cb;
+    int        audio_subid;
+
+    /* partial pack carried between feeds */
+    uint8_t    pack[PS_PACK_SIZE];
+    size_t     pack_fill;
+
+    /* video access unit being built */
+    uint8_t*   au;
+    size_t     au_len, au_cap;
+    size_t     scan;          /* next au index to look for a start code at */
+    uint64_t   au_base;       /* ES byte position of au[0] */
+    uint64_t   es_pos;        /* ES bytes appended so far (== au_base + au_len) */
+    int        seen_pic;      /* au holds a picture start code */
+    int64_t    au_pts;        /* PTS of that picture, -1 none */
+
+    /* PTS of the last PES that had one, waiting for the first picture start
+     * code that begins at or after that PES's payload (ISO 13818-1 2.4.3.7:
+     * the PTS belongs to the first AU whose start code commences in it). */
+    int64_t    pend_pts;
+    uint64_t   pend_pos;
+
+    /* first sequence header + extensions */
+    uint8_t    seq[PS_SEQ_MAX];
+    size_t     seq_len;
+    int        have_seq;
+    size_t     seq_cap_off;   /* au index of the B3 being captured, or PS_NO_OFF */
+    int        frame_rate_code;
+};
+
+/* ---------------------------------------------------------------------------
+ * Video: start-code splitter
+ * -----------------------------------------------------------------------*/
+
+/* Hand au[0..p) out as one picture and slide the rest to the front. The
+ * remainder is at most the tail of the PES just appended (~2 KB), so the
+ * memmove is cheap. */
+static void sail_ps_cut(sail_ps* ps, size_t p)
+{
+    if (p && ps->seen_pic && ps->cb.video_au)
+        ps->cb.video_au(ps->cb.user, ps->au, p, ps->au_pts);
+    memmove(ps->au, ps->au + p, ps->au_len - p);
+    ps->au_len  -= p;
+    ps->au_base += p;
+    ps->scan     = ps->scan > p ? ps->scan - p : 0;
+    if (ps->seq_cap_off != PS_NO_OFF)
+        ps->seq_cap_off = ps->seq_cap_off >= p ? ps->seq_cap_off - p : PS_NO_OFF;
+    ps->seen_pic = 0;
+    ps->au_pts   = -1;
+}
+
+/* A start code 00 00 01 <code> begins at au[s]. Returns the index to resume
+ * scanning from (just past the 4 start-code bytes, after any shift). */
+static size_t sail_ps_on_code(sail_ps* ps, size_t s, uint8_t code)
+{
+    /* Finish capturing the first sequence header: it runs from its B3 up to
+     * the first start code that is not one of its B5 extensions. */
+    if (!ps->have_seq && ps->seq_cap_off != PS_NO_OFF && code != 0xB5) {
+        size_t n = s - ps->seq_cap_off;
+        if (n >= 12 && n <= PS_SEQ_MAX) {
+            memcpy(ps->seq, ps->au + ps->seq_cap_off, n);
+            ps->seq_len = n;
+            ps->have_seq = 1;
+            /* byte 7: aspect_ratio_information(4) | frame_rate_code(4) */
+            ps->frame_rate_code = ps->seq[7] & 0x0F;
+        }
+        ps->seq_cap_off = PS_NO_OFF;
+    }
+
+    switch (code) {
+    case 0x00: /* picture_start_code */
+        if (ps->seen_pic) {
+            sail_ps_cut(ps, s);
+            s = 0;
+        }
+        ps->seen_pic = 1;
+        if (ps->pend_pts >= 0 && ps->au_base + s >= ps->pend_pos) {
+            ps->au_pts = ps->pend_pts;
+            ps->pend_pts = -1;
+        }
+        break;
+    case 0xB3: /* sequence_header_code */
+    case 0xB8: /* group_start_code */
+        /* Headers after slice data start the next picture's AU. */
+        if (ps->seen_pic) {
+            sail_ps_cut(ps, s);
+            s = 0;
+        }
+        if (code == 0xB3 && !ps->have_seq)
+            ps->seq_cap_off = s;
+        break;
+    case 0xB7: /* sequence_end_code: stays on the last AU, flushes it */
+        sail_ps_cut(ps, s + 4);
+        return 0;
+    default:   /* slices, B2 user data, B5 extensions: part of the current AU */
+        break;
+    }
+    return s + 4;
+}
+
+/* Scan au[scan..] for start codes. A code needs its 4th byte present, so the
+ * last 3 bytes stay unscanned until more data arrives. */
+static void sail_ps_scan(sail_ps* ps)
+{
+    size_t i = ps->scan;
+    while (i + 3 < ps->au_len) {
+        /* look for the 0x01 of 00 00 01 at j = i+2 .. au_len-2 */
+        const uint8_t* hit = (const uint8_t*)memchr(ps->au + i + 2, 0x01,
+                                                    ps->au_len - 1 - (i + 2));
+        if (!hit) {
+            i = ps->au_len - 3;
+            break;
+        }
+        size_t j = (size_t)(hit - ps->au);
+        if (ps->au[j - 1] == 0 && ps->au[j - 2] == 0) {
+            i = sail_ps_on_code(ps, j - 2, ps->au[j + 1]);
+        } else {
+            i = j - 1; /* next window starts its 0x01 search at j+1 */
+        }
+    }
+    ps->scan = i;
+}
+
+static int sail_ps_video(sail_ps* ps, const uint8_t* p, size_t n)
+{
+    int rc = 0;
+    if (!n)
+        return 0;
+    if (ps->au_len + n > ps->au_cap) {
+        size_t cap = ps->au_cap ? ps->au_cap : 256u * 1024u;
+        while (cap < ps->au_len + n)
+            cap *= 2;
+        if (cap > PS_AU_MAX + 4096u) {
+            /* runaway AU: no picture boundary in 16 MB. Drop it. */
+            ps->au_base += ps->au_len;
+            ps->au_len = 0;
+            ps->scan = 0;
+            ps->seen_pic = 0;
+            ps->au_pts = -1;
+            ps->seq_cap_off = PS_NO_OFF;
+            rc = SAIL_PS_ERR_AU;
+            if (n > ps->au_cap)
+                return rc;
+        } else {
+            uint8_t* nb = (uint8_t*)realloc(ps->au, cap);
+            if (!nb)
+                return SAIL_PS_ERR_AU;
+            ps->au = nb;
+            ps->au_cap = cap;
+        }
+    }
+    memcpy(ps->au + ps->au_len, p, n);
+    ps->au_len += n;
+    ps->es_pos += n;
+    sail_ps_scan(ps);
+    return rc;
+}
+
+/* ---------------------------------------------------------------------------
+ * Packs and PES packets
+ * -----------------------------------------------------------------------*/
+
+static int64_t sail_ps_read_ts(const uint8_t* b)
+{
+    return ((int64_t)((b[0] >> 1) & 7) << 30) | ((int64_t)b[1] << 22) |
+           ((int64_t)(b[2] >> 1) << 15) | ((int64_t)b[3] << 7) | (b[4] >> 1);
+}
+
+static int sail_ps_pack(sail_ps* ps, const uint8_t* pk)
+{
+    int rc = 0;
+    if (pk[0] != 0 || pk[1] != 0 || pk[2] != 1 || pk[3] != 0xBA)
+        return SAIL_PS_ERR_SYNC;
+    /* MPEG-2 pack header ('01' marker bits); an MPEG-1 one would be 12 bytes */
+    if ((pk[4] & 0xC0) != 0x40)
+        return SAIL_PS_ERR_SYNC;
+    size_t off = 14u + (pk[13] & 7u);
+
+    while (off + 6 <= PS_PACK_SIZE) {
+        const uint8_t* h = pk + off;
+        if (h[0] != 0 || h[1] != 0 || h[2] != 1)
+            return rc ? rc : SAIL_PS_ERR_PACKET;
+        uint8_t id = h[3];
+        if (id == 0xB9) /* program end */
+            break;
+        size_t len = ((size_t)h[4] << 8) | h[5];
+        size_t end = off + 6 + len;
+        if (end > PS_PACK_SIZE || len == 0)
+            return SAIL_PS_ERR_PACKET;
+
+        if (id == 0xE0 || id == 0xBD) {
+            /* MPEG-2 PES header: '10' flags1, flags2 (PTS_DTS in 0xC0),
+             * header_data_length; payload follows it. */
+            if (len < 3 || (h[6] & 0xC0) != 0x80) {
+                rc = SAIL_PS_ERR_PACKET;
+            } else {
+                size_t hdr = 9u + h[8];
+                if (off + hdr > end) {
+                    rc = SAIL_PS_ERR_PACKET;
+                } else {
+                    const uint8_t* pl = h + hdr;
+                    size_t pn = end - (off + hdr);
+                    if (id == 0xE0) {
+                        if ((h[7] & 0x80) && h[8] >= 5) {
+                            ps->pend_pts = sail_ps_read_ts(h + 9);
+                            ps->pend_pos = ps->es_pos;
+                        }
+                        int vr = sail_ps_video(ps, pl, pn);
+                        if (vr && !rc)
+                            rc = vr;
+                    } else if (pn >= 4 && pl[0] == (uint8_t)ps->audio_subid) {
+                        /* skip "40 31 HH LL"; HHLL points at the first 960-byte
+                         * audio unit, which a byte-stream consumer ignores */
+                        if (ps->cb.lpcm && pn > 4)
+                            ps->cb.lpcm(ps->cb.user, pl + 4, pn - 4);
+                    }
+                }
+            }
+        }
+        /* BB system header, BE padding, BF private 2, other streams: skip */
+        off = end;
+    }
+    return rc;
+}
+
+/* ---------------------------------------------------------------------------
+ * Public API
+ * -----------------------------------------------------------------------*/
+
+sail_ps* sail_ps_create(const sail_ps_cb* cb, int audio_subid)
+{
+    sail_ps* ps = (sail_ps*)calloc(1, sizeof(*ps));
+    if (!ps)
+        return NULL;
+    if (cb)
+        ps->cb = *cb;
+    ps->audio_subid = audio_subid;
+    ps->au_pts = -1;
+    ps->pend_pts = -1;
+    ps->seq_cap_off = PS_NO_OFF;
+    return ps;
+}
+
+int sail_ps_feed(sail_ps* ps, const uint8_t* data, size_t n)
+{
+    int rc = 0, r;
+    if (!ps || (!data && n))
+        return SAIL_PS_ERR_ARG;
+
+    /* complete a pack left over from the previous call */
+    if (ps->pack_fill) {
+        size_t take = PS_PACK_SIZE - ps->pack_fill;
+        if (take > n)
+            take = n;
+        memcpy(ps->pack + ps->pack_fill, data, take);
+        ps->pack_fill += take;
+        data += take;
+        n -= take;
+        if (ps->pack_fill < PS_PACK_SIZE)
+            return 0;
+        ps->pack_fill = 0;
+        r = sail_ps_pack(ps, ps->pack);
+        if (r && !rc)
+            rc = r;
+    }
+    while (n >= PS_PACK_SIZE) {
+        r = sail_ps_pack(ps, data);
+        if (r && !rc)
+            rc = r;
+        data += PS_PACK_SIZE;
+        n -= PS_PACK_SIZE;
+    }
+    if (n) {
+        memcpy(ps->pack, data, n);
+        ps->pack_fill = n;
+    }
+    return rc;
+}
+
+void sail_ps_flush(sail_ps* ps)
+{
+    if (!ps)
+        return;
+    /* A trailing partial pack cannot be parsed; the game's files end on a
+     * whole pack, so it is simply dropped. */
+    ps->pack_fill = 0;
+    /* The bytes still unscanned (< 3) can hold no start code that matters. */
+    /* emits only when the AU holds a picture; bare headers are discarded */
+    sail_ps_cut(ps, ps->au_len);
+    ps->scan = 0;
+    ps->seq_cap_off = PS_NO_OFF;
+    ps->pend_pts = -1;
+}
+
+const uint8_t* sail_ps_seq_header(const sail_ps* ps, size_t* n)
+{
+    if (!ps || !ps->have_seq) {
+        if (n)
+            *n = 0;
+        return NULL;
+    }
+    if (n)
+        *n = ps->seq_len;
+    return ps->seq;
+}
+
+int sail_ps_frame_rate_code(const sail_ps* ps)
+{
+    return ps ? ps->frame_rate_code : 0;
+}
+
+void sail_ps_reset(sail_ps* ps)
+{
+    if (!ps)
+        return;
+    ps->pack_fill = 0;
+    ps->au_len = 0;
+    ps->scan = 0;
+    ps->au_base = 0;
+    ps->es_pos = 0;
+    ps->seen_pic = 0;
+    ps->au_pts = -1;
+    ps->pend_pts = -1;
+    ps->pend_pos = 0;
+    ps->seq_cap_off = PS_NO_OFF;
+}
+
+void sail_ps_destroy(sail_ps* ps)
+{
+    if (!ps)
+        return;
+    free(ps->au);
+    free(ps);
+}
diff --git a/libs/codec/sail_mpegps.h b/libs/codec/sail_mpegps.h
new file mode 100644
index 0000000..347ed8d
--- /dev/null
+++ b/libs/codec/sail_mpegps.h
@@ -0,0 +1,93 @@
+/*
+ * ps3recomp - MPEG-2 Program Stream demuxer for cellSail's PAMF player
+ *
+ * Demon's Souls NOTES fix 71: the game's movies (*.pam) are PAMF files
+ * whose payload is a plain MPEG-2 Program Stream of 2048-byte packs:
+ * MPEG-2 video in PES 0xE0 and 16-bit big-endian LPCM in private stream 1
+ * (0xBD, sub-id 0x40). The game imports no cellDmux/cellVdec/cellAdec, so
+ * cellSail has to split the stream itself; this file does only that.
+ *
+ * Pure C: no globals, no guest memory, no threads. The caller reads the
+ * file (from the PAMF data offset, be32 @0x08 * 2048) and feeds packs in
+ * order; the demuxer calls back with
+ *   - one video access unit per coded picture, in coded (decode) order.
+ *     Sequence header, sequence/display extensions, user data and GOP header
+ *     travel with the picture that follows them, so an AU is always
+ *     decodable on its own as far as headers go; a sequence end code (B7)
+ *     stays on the AU it ends and flushes it at once.
+ *     pts90k is the PES PTS whose packet holds this picture's start code,
+ *     or -1. PAMF carries one PTS per GOP (on the I picture, display time),
+ *     so the player derives the rest at 90000/frame-rate ticks per frame.
+ *   - LPCM payload bytes with the 4-byte "40 31 HH LL" private header
+ *     removed, in stream order. These chunks are NOT sample aligned (a
+ *     packet with a P-STD extension carries 2013 bytes, the others 2016),
+ *     so n may be odd: the receiver must treat them as one byte stream and
+ *     concatenate them before cutting samples or frames.
+ *
+ * Both callbacks run inside sail_ps_feed / sail_ps_flush on the caller's
+ * thread; the buffers are only valid for the duration of the call.
+ */
+
+#ifndef PS3RECOMP_SAIL_MPEGPS_H
+#define PS3RECOMP_SAIL_MPEGPS_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct sail_ps sail_ps;
+
+typedef struct {
+    /* One coded picture (plus the headers before it). pts90k = -1 when no
+     * PTS belongs to this picture. */
+    void (*video_au)(void* user, const uint8_t* au, size_t n, int64_t pts90k);
+    /* LPCM bytes, big-endian 16-bit interleaved, header stripped; any n. */
+    void (*lpcm)(void* user, const uint8_t* pcm_be16, size_t n);
+    void* user;
+} sail_ps_cb;
+
+/* sail_ps_feed results below 0 */
+#define SAIL_PS_ERR_SYNC    (-1)  /* a pack did not start with 00 00 01 BA */
+#define SAIL_PS_ERR_PACKET  (-2)  /* a packet header was malformed / overran its pack */
+#define SAIL_PS_ERR_AU      (-3)  /* video AU grew past the sanity cap; dropped */
+#define SAIL_PS_ERR_ARG     (-4)
+
+/* audio_subid: the private stream 1 sub-id to pass through (0x40 = first
+ * LPCM stream, as PAMF's stream table at +0x0D says). Callbacks may be NULL.
+ * Returns NULL on allocation failure. The cb struct is copied. */
+sail_ps* sail_ps_create(const sail_ps_cb* cb, int audio_subid);
+
+/* Feed stream bytes in order. Meant for whole 2048-byte packs (any number),
+ * but a partial pack is kept and completed by the next call, so any chunking
+ * works. Returns 0 when every pack parsed, else the first error seen; the
+ * demuxer resynchronises on the next pack either way. */
+int sail_ps_feed(sail_ps* ps, const uint8_t* data, size_t n);
+
+/* End of data: emit the last pending picture AU (one not closed by a B7). */
+void sail_ps_flush(sail_ps* ps);
+
+/* The first sequence header (B3) plus the extensions right behind it (B5:
+ * sequence extension, sequence display extension), start codes included -
+ * what MF_MT_MPEG_SEQUENCE_HEADER wants. NULL (and *n = 0) until seen. */
+const uint8_t* sail_ps_seq_header(const sail_ps* ps, size_t* n);
+
+/* frame_rate_code from that sequence header (4 = 29.97, 3003 ticks/frame);
+ * 0 until seen. */
+int sail_ps_frame_rate_code(const sail_ps* ps);
+
+/* Forget everything partial (pack carry, half-built AU, pending PTS) so the
+ * stream can be fed again from its first pack (rewind / loop). The captured
+ * sequence header and frame rate code are kept: they are stream properties
+ * and the first AU repeats them anyway. */
+void sail_ps_reset(sail_ps* ps);
+
+void sail_ps_destroy(sail_ps* ps);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PS3RECOMP_SAIL_MPEGPS_H */
