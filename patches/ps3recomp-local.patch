+static int ld_vc_enabled(void)
+{
+    static int on = -1;
+    if (on < 0) {
+        const char* e = getenv("LD_VCACHE");
+        /* The draw CSV and its vertex dumps read dc's converted vertices,
+         * which a hit never fills. */
+        on = (e && e[0] == '0') || getenv("RSX_DRAW_CSV") ? 0 : 1;
+        if (on) g_ld_vc = (ld_vc_entry*)calloc(LD_VC_SLOTS, sizeof(ld_vc_entry));
