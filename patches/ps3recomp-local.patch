+/* Submit what is recorded so far without waiting, on the next kick allocator (none left or
+ * none creatable: 0, nothing submitted). The list starts empty again; draws set their own state. */
+static int ld_kick_now(void)
+{
+    if (g_ld_kick_n >= LD_KICK_ALLOCS) return 0;
+    ID3D12CommandAllocator** next = &g_ld_kick_alloc[g_ld_kick_n];
+    if (!*next && FAILED(g.dev->lpVtbl->CreateCommandAllocator(
+            g.dev, D3D12_COMMAND_LIST_TYPE_DIRECT, &IID_ID3D12CommandAllocator, (void**)next))) {
+        *next = NULL;
+        return 0;
+    }
+    ld_occ_resolve();
+    if (FAILED(g.list->lpVtbl->Close(g.list))) { g.ready = 0; return 0; }
+    ID3D12CommandList* lists[] = {(ID3D12CommandList*)g.list};
+    ld_ecl(lists, "ecl k");   /* fix 129 */
+    g.queue->lpVtbl->Signal(g.queue, g.fence, ++g.fence_value);
