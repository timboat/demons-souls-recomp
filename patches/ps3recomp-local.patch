+static inline u64 ld_vc_rotl(u64 x, int r) { return (x << r) | (x >> (64 - r)); }
+
+/* Mutation detector over guest bytes: four independent multiply lanes so
+ * the loop runs at memory speed rather than one multiply's latency. */
+static u64 ld_vc_hash(const u8* p, size_t n, u64 seed)
+{
+    const u64 P1 = 0x9E3779B185EBCA87ull, P2 = 0xC2B2AE3D27D4EB4Full;
+    u64 a = seed ^ P1, b = seed + P2, c = ld_vc_rotl(seed, 17) ^ P2,
+        d = seed * P1 + 1;
+    size_t i = 0;
+    for (; i + 32 <= n; i += 32) {
+        u64 w[4];
+        memcpy(w, p + i, 32);
+        a = ld_vc_rotl(a ^ w[0], 29) * P1;
+        b = ld_vc_rotl(b ^ w[1], 29) * P1;
+        c = ld_vc_rotl(c ^ w[2], 29) * P1;
+        d = ld_vc_rotl(d ^ w[3], 29) * P1;
+    }
+    u64 h = ld_vc_rotl(a, 1) + ld_vc_rotl(b, 7) + ld_vc_rotl(c, 12) +
+            ld_vc_rotl(d, 18) + (u64)n * P2;
+    for (; i + 8 <= n; i += 8) {
+        u64 w;
+        memcpy(&w, p + i, 8);
+        h = ld_vc_rotl(h ^ (w * P2), 31) * P1;
+    }
+    for (; i < n; i++)
+        h = (h ^ p[i]) * P1;
+    h ^= h >> 33; h *= P2; h ^= h >> 29;
+    return h;
+}
