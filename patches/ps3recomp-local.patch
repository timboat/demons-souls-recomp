+
+static LRESULT CALLBACK osk_wndproc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    switch (msg) {
+    case WM_COMMAND:
+        if (LOWORD(wp) == IDOK)     { osk_window_done(hwnd, 1); return 0; }
+        if (LOWORD(wp) == IDCANCEL) { osk_window_done(hwnd, 0); return 0; }
+        if (LOWORD(wp) == OSK_ID_EDIT && HIWORD(wp) == EN_CHANGE)   /* no empty names */
+            EnableWindow(GetDlgItem(hwnd, IDOK),
+                         GetWindowTextLengthW(GetDlgItem(hwnd, OSK_ID_EDIT)) > 0);
+        break;
+    case WM_TIMER: {   /* OSK_BOX_AUTO=<text>[|<shot.bmp>]: TEST -- type <text> and press OK */
+        KillTimer(hwnd, 1);
+        const char* e = getenv("OSK_BOX_AUTO");
+        if (!e) break;
+        char txt[CELL_OSK_MAX_TEXT_LENGTH + 1]; const char* bar = strchr(e, '|');
+        size_t n = bar ? (size_t)(bar - e) : strlen(e);
+        if (n > CELL_OSK_MAX_TEXT_LENGTH) n = CELL_OSK_MAX_TEXT_LENGTH;
+        memcpy(txt, e, n); txt[n] = 0;
+        SetDlgItemTextA(hwnd, OSK_ID_EDIT, txt);
+        if (bar && bar[1]) {   /* a picture of the box, as a 32-bit BMP */
+            RECT r; GetWindowRect(hwnd, &r);
+            const int w = r.right - r.left, h = r.bottom - r.top;
+            HDC sdc = GetDC(hwnd), mdc = CreateCompatibleDC(sdc);
+            BITMAPINFO bi = {0}; bi.bmiHeader.biSize = sizeof bi.bmiHeader;
+            bi.bmiHeader.biWidth = w; bi.bmiHeader.biHeight = h; bi.bmiHeader.biPlanes = 1;
+            bi.bmiHeader.biBitCount = 32; bi.bmiHeader.biCompression = BI_RGB;
+            void* bits = NULL;
+            HBITMAP bmp = CreateDIBSection(mdc, &bi, DIB_RGB_COLORS, &bits, NULL, 0);
+            if (bmp && bits) {
+                HGDIOBJ old = SelectObject(mdc, bmp);
+                PrintWindow(hwnd, mdc, 2 /* PW_RENDERFULLCONTENT */);
+                GdiFlush();
+                FILE* f = fopen(bar + 1, "wb");
+                if (f) {
+                    BITMAPFILEHEADER fh = {0};
+                    fh.bfType = 0x4D42; fh.bfOffBits = sizeof fh + sizeof bi.bmiHeader;
+                    fh.bfSize = fh.bfOffBits + (DWORD)(w * h * 4);
+                    fwrite(&fh, sizeof fh, 1, f); fwrite(&bi.bmiHeader, sizeof bi.bmiHeader, 1, f);
+                    fwrite(bits, 4, (size_t)w * h, f); fclose(f);
+                }
+                SelectObject(mdc, old);
