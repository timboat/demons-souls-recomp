 /*
  * ps3recomp - cellSail HLE implementation
  *
- * Stub. Player lifecycle and state management work.
- * No actual media playback occurs — games typically show
- * a black screen for cutscenes, which is acceptable for
- * initial recompilation testing.
+ * The SDK's movie player. A title creates a player with a memory allocator and
+ * two adapters (graphics: hands out decoded frames in buffers the title
+ * allocates; sound: hands out PCM the title mixes), opens a stream through a
+ * descriptor, and from then on everything is asynchronous: the player reports
+ * each step through the title's event callback, and the title pulls frames and
+ * samples from the adapters.
+ *
+ * PAMF movies (MPEG-2 video + LPCM, what Demon's Souls ships) really play
+ * (Demon's Souls NOTES fix 71): sail_engine.c demuxes and decodes them on host
+ * threads, and the adapter calls below hand the results over on the title's own
+ * threads. Anything else -- another container, no allocator -- keeps the old
+ * behaviour of a stream that opens and ends at once, which other titles depend
+ * on (Midway's logo AVIs wait for exactly that). A PAMF with no MPEG-2 decoder
+ * on this machine reports an error, and the title skips that movie.
+ *
+ * Switches: PS3_NO_SAIL=1 (player creation fails: the title skips its movies),
+ * PS3_SAIL_DECODER=none (act as if there were no decoder: PAMF movies skipped),
+ * PS3_SAIL_SKIP=<substr,...> (those movies report an error and are skipped),
+ * PS3_SAIL_FORCE=<host .pam> (play this file for any movie -- tests),
+ * PS3_SAIL_PCM=f32|s16 (sample format handed to the title; f32 = SDK LPCM float),
+ * PS3_SAIL_AV_MS=<n> (shift video n ms later against the audio),
+ * PS3_SAIL_LOG=1 (every call, plus a line a second while playing).
  */
 
 #include "ps3emu/guest_call.h"
 #include "cellSail.h"
+#include "cellPamf.h"
+#include "sail_engine.h"
 #include "../../runtime/ppu/ppu_memory.h"   /* vm_read32 / vm_write32 */
+#include "../../runtime/syscalls/sys_fs.h"  /* sys_fs_translate_path */
 #include <stdio.h>
 #include <string.h>
 #include <stdlib.h>   /* getenv -- Clang errors on the implicit declaration MSVC allows */
 #include "../guest_struct.h"   /* GUEST_EA, guest_struct_load/store */
+#ifdef _WIN32
+#include <windows.h>
+#else
+#include "../../runtime/platform/win32_compat.h"   /* the lock, the clock and the future wait below */
+#endif
+
+/* ppu_loader.cpp: run a guest function (by OPD) on this thread and return r3. */
+extern uint64_t ppu_guest_call(uint32_t opd_addr, uint64_t a0, uint64_t a1, uint64_t a2, uint64_t a3,
+                               uint64_t a4, uint64_t a5, uint64_t a6, uint64_t a7);
+
+/* ppu_fs.cpp: the cellFs layer's host root, and its PS3_GAME fallback. Movies
+ * are opened the way the title's own cellFsOpen would find them. */
+extern const char* ppu_vfs_root;
+extern void ps3_vfs_ps3game_fallback(char* path, size_t cap);
+
+static void sail_host_path(const char* guest, char* out, size_t cap)
+{
+    static const char* const mounts[] = { "/dev_bdvd/", "/app_home/" };
+    const char* rel = NULL;
+    for (size_t i = 0; i < sizeof mounts / sizeof mounts[0]; i++)
+        if (!strncmp(guest, mounts[i], strlen(mounts[i]))) { rel = guest + strlen(mounts[i]); break; }
+    if (rel && ppu_vfs_root) {
+        snprintf(out, cap, "%s/%s", ppu_vfs_root, rel);
+        for (char* q = out; *q; q++) if (*q == '\\') *q = '/';
+        ps3_vfs_ps3game_fallback(out, cap);
+        FILE* f = fopen(out, "rb");
+        if (f) { fclose(f); return; }
+    }
+    sys_fs_translate_path(guest, out, (int)cap);   /* /dev_hdd0 etc. */
