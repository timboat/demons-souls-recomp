+    if (!s_hot_state) s_hot_state = hot_init() ? 1 : -1;
+    if (s_hot_state > 0) {
+        /* this thread gives up a slot it still holds (its generation is current): back to the default set */
+        if (t_hot_slot >= 0 && t_hot_slot != slot && s_hot_owner[t_hot_slot] &&
+            t_hot_gen == s_hot_gen[t_hot_slot]) {
+            SetThreadSelectedCpuSets(GetCurrentThread(), NULL, 0);
+            CloseHandle(s_hot_owner[t_hot_slot]); s_hot_owner[t_hot_slot] = NULL;
+            InterlockedIncrement(&s_hot_gen[t_hot_slot]);
+        }
+        /* the slot's previous thread goes back to the default set */
+        if (s_hot_owner[slot]) {
+            SetThreadSelectedCpuSets(s_hot_owner[slot], NULL, 0);
+            CloseHandle(s_hot_owner[slot]); s_hot_owner[slot] = NULL;
+        }
+        ULONG ids[8]; ULONG nids = 0;
+        for (int i = 0; i < s_hot_n && nids < 8; i++) if (s_hot_core[i] == s_hot_pick[slot]) ids[nids++] = s_hot_all[i];
+        HANDLE me = NULL;
+        if (DuplicateHandle(GetCurrentProcess(), GetCurrentThread(), GetCurrentProcess(), &me,
+                            THREAD_SET_LIMITED_INFORMATION | THREAD_QUERY_LIMITED_INFORMATION, FALSE, 0) &&
+            SetThreadSelectedCpuSets(GetCurrentThread(), ids, nids)) {
+            s_hot_owner[slot] = me;
+            if (!s_hot_claimed[slot]) {
+                s_hot_claimed[slot] = 1;
+                if (!hot_set_default())
+                    fprintf(stderr, "[hotcores] SetProcessDefaultCpuSets failed (%lu)\n", GetLastError());
+            }
+            static int s_moves;
+            if (PS3_LOG_FIRST(s_moves, 8))
+                fprintf(stderr, "[hotcores] slot %d (%s) now on host thread %lu\n", slot,
+                        slot ? "dispatcher" : "HighGraphics", GetCurrentThreadId());
+        } else if (me) {
+            CloseHandle(me);
+        }
+        InterlockedIncrement(&s_hot_gen[slot]);
+    }
+    t_hot_slot = slot;
+    t_hot_gen  = __atomic_load_n(&s_hot_gen[slot], __ATOMIC_RELAXED);
+    ReleaseSRWLockExclusive(&s_hot_lock);
