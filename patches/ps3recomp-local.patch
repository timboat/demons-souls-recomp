+ * refreshes for a second or two instead of an even 2 / 2 -- short judder bursts with every frame on
+ * time. This thread waits for the window's real vblanks (IDXGIOutput::WaitForVBlank) and keeps a
+ * least-squares fit of their times (period + phase) over the last 256; the ticker places its ticks
+ * on that grid when its own rate is a whole multiple of the display's. LD_VBLANK_LOCK=0 = off.
+ * Demon's Souls NOTES fix 133: the samples now come from the swap chain's frame statistics when it
+ * has them (SyncRefreshCount + SyncQPCTime: the driver's own vblank count and time, read after each
+ * Present). WaitForVBlank wake-ups are late by a varying amount and, on Windows 11 26300, the call
+ * spins: from run to run the fit put the same display at 60.004-60.030 Hz (its frame statistics:
+ * 60.001-60.004), the guest clock wandered 59.89-60.00 Hz over 20 s windows, frames queued up to 3
+ * deep and every change of depth was an 8.3 ms slip between game time and screen time. The thread only waits for vblanks while the statistics are missing
+ * (before the first present, or after a mode change). LD_VBLANK_STATS=0 = the old WaitForVBlank source. */
+#define LDVB_N 256
+static struct {
+    SRWLOCK lock;                                          /* the fitted grid (readers: the ticker) */
+    SRWLOCK wlock;                                         /* the samples: one writer at a time */
+    double t[LDVB_N]; long long k[LDVB_N]; int n, head;   /* samples: QPC us, refresh index */
+    double base_us, period_us; int valid;                  /* fitted grid: a vblank at base, every period */
+    long long idx; double last_t;
+    int since_fit;                                         /* samples since the last fit */
+    volatile LONG from_stats;                              /* 1: samples come from frame statistics */
+} g_ldvb;
+
+static double ldvb_now_us(void)
+{
+    static LARGE_INTEGER f; LARGE_INTEGER c;
+    if (!f.QuadPart) QueryPerformanceFrequency(&f);
+    QueryPerformanceCounter(&c);
+    return (double)c.QuadPart * 1e6 / (double)f.QuadPart;
+}
+
+static void ldvb_fit(void)
+{
+    /* two passes: fit, drop samples more than 1 ms off the line (late wake-ups), fit again */
+    double sk = 0, st = 0, skk = 0, skt = 0, a = 0, b = 0; int m = 0;
+    for (int pass = 0; pass < 2; pass++) {
+        sk = st = skk = skt = 0; m = 0;
+        const double k0 = (double)g_ldvb.k[(g_ldvb.head - g_ldvb.n + LDVB_N) % LDVB_N];
+        for (int i = 0; i < g_ldvb.n; i++) {
+            const int j = (g_ldvb.head - g_ldvb.n + i + LDVB_N) % LDVB_N;
+            const double k = (double)g_ldvb.k[j] - k0, t = g_ldvb.t[j];
+            if (pass && fabs(t - (a + b * k)) > 1000.0) continue;
+            sk += k; st += t; skk += k * k; skt += k * t; m++;
+        }
+        const double d = m * skk - sk * sk;
+        if (m < 32 || d <= 0) return;
+        b = (m * skt - sk * st) / d; a = (st - b * sk) / m;
+        if (!pass) continue;
+        const double kn = (double)g_ldvb.k[(g_ldvb.head - 1 + LDVB_N) % LDVB_N] - k0;
+        AcquireSRWLockExclusive(&g_ldvb.lock);
+        g_ldvb.period_us = b; g_ldvb.base_us = a + b * kn;   /* the grid point of the newest sample */
+        g_ldvb.valid = b > 2000.0 && b < 50000.0;
+        ReleaseSRWLockExclusive(&g_ldvb.lock);
+    }
+}
+
+/* One vblank sample (time, refresh index); the caller holds wlock. */
+static void ldvb_add(double t, long long k)
+{
+    g_ldvb.idx = k; g_ldvb.last_t = t;
+    g_ldvb.t[g_ldvb.head] = t; g_ldvb.k[g_ldvb.head] = k;
+    g_ldvb.head = (g_ldvb.head + 1) % LDVB_N;
+    if (g_ldvb.n < LDVB_N) g_ldvb.n++;
+    if (g_ldvb.period_us <= 0 && g_ldvb.n >= 8) {   /* first estimate before the fit has samples */
+        const int j0 = (g_ldvb.head - g_ldvb.n + LDVB_N) % LDVB_N;
+        if (k > g_ldvb.k[j0]) g_ldvb.period_us = (t - g_ldvb.t[j0]) / (double)(k - g_ldvb.k[j0]);
+    }
+    if (g_ldvb.n >= 32 && ++g_ldvb.since_fit >= 16) { g_ldvb.since_fit = 0; ldvb_fit(); }
+}
+
+static DWORD WINAPI ldvb_thread(LPVOID unused)
+{
+    (void)unused;
+    IDXGIOutput* out = NULL;
+    double next_query = 0;
+    for (;;) {
+        if (g_ldvb.from_stats) { Sleep(50); continue; }   /* fix 133: the present path feeds the fit */
+        const double now = ldvb_now_us();
+        if (!out || now >= next_query) {           /* the window may move to another monitor */
+            if (out) { out->lpVtbl->Release(out); out = NULL; }
+            if (FAILED(g.swap->lpVtbl->GetContainingOutput(g.swap, &out))) { out = NULL; Sleep(100); continue; }
+            next_query = now + 5e6;
+        }
+        if (FAILED(out->lpVtbl->WaitForVBlank(out))) { out->lpVtbl->Release(out); out = NULL; Sleep(10); continue; }
+        const double t = ldvb_now_us();
+        AcquireSRWLockExclusive(&g_ldvb.wlock);
+        if (!g_ldvb.from_stats) {
+            long long k = g_ldvb.idx + 1;
+            if (g_ldvb.n && g_ldvb.period_us > 0) {     /* whole refreshes since the last sample (missed waits) */
+                long long steps = (long long)floor((t - g_ldvb.last_t) / g_ldvb.period_us + 0.5);
+                if (steps < 1) steps = 1;
+                if (steps > 100000) { g_ldvb.n = 0; steps = 1; }   /* long stall / monitor change: start over */
+                k = g_ldvb.idx + steps;
+            }
+            ldvb_add(t, k);
+        }
+        ReleaseSRWLockExclusive(&g_ldvb.wlock);
+    }
+}
+
+/* fix 134: present-to-screen delay for the perf recording. Each Present's number and time go in a ring; when the
+ * frame statistics name the present a vblank showed, the delay is that vblank's time minus the present's. Notes:
+ * "lat <min> <median> <max>" (ms) once a second, "slip <from> <to>" when it moves by over 2 ms -- a slip between
+ * game time and screen time, the judder PresentMon showed (fix 133). */
+static struct { UINT cnt; double t; } g_ld_pres_ring[64];
+static void ld_pres_ring_note(void)
+{
+    UINT lp = 0;
+    if (g.swap && SUCCEEDED(g.swap->lpVtbl->GetLastPresentCount(g.swap, &lp))) {
+        g_ld_pres_ring[lp & 63].cnt = lp; g_ld_pres_ring[lp & 63].t = ldvb_now_us(); }
+}
+static void ld_pres_latency(UINT present_count, double vblank_us)
+{
+    static double last = -1, win[128], win_t0; static int nw;
+    const int i = (int)(present_count & 63);
+    if (g_ld_pres_ring[i].cnt != present_count || g_ld_pres_ring[i].t <= 0) return;
+    const double lat = (vblank_us - g_ld_pres_ring[i].t) / 1000.0;
+    if (lat < 0 || lat > 500) return;
+    if (last >= 0 && fabs(lat - last) > 2.0) ps3_perf_note("slip %.1f %.1f", last, lat);
+    last = lat;
+    if (nw < 128) win[nw++] = lat;
+    if (!win_t0) win_t0 = vblank_us;
+    if (vblank_us - win_t0 >= 1e6 && nw) {
+        for (int a = 1; a < nw; a++) { const double v = win[a]; int b = a; while (b > 0 && win[b - 1] > v) { win[b] = win[b - 1]; b--; } win[b] = v; }
+        ps3_perf_note("lat %.1f %.1f %.1f", win[0], win[nw / 2], win[nw - 1]);
+        nw = 0; win_t0 = vblank_us;
+    }
+}
+
+/* fix 133: after a Present, the swap chain's frame statistics -- the driver's count and QPC time of
+ * the vblank that last showed a frame -- as the fit's sample (one per new refresh count). They switch
+ * the source over (the WaitForVBlank thread parks); a second without them hands it back. */
+static void ldvb_from_stats(void)
+{
+    static int on = -1; static UINT last_sync; static double good_us; static int said;
+    if (on < 0) { const char* e = getenv("LD_VBLANK_STATS"); const char* l = getenv("LD_VBLANK_LOCK");
+                  on = !(e && e[0] == '0') && !(l && l[0] == '0'); }
+    if (!on || !g.swap) return;
+    static LARGE_INTEGER f;
+    if (!f.QuadPart) QueryPerformanceFrequency(&f);
+    DXGI_FRAME_STATISTICS fs; memset(&fs, 0, sizeof fs);
+    const double now = ldvb_now_us();
+    const HRESULT hr = g.swap->lpVtbl->GetFrameStatistics(g.swap, &fs);
+    if (hr == DXGI_ERROR_FRAME_STATISTICS_DISJOINT) {   /* output or mode changed: a new series */
+        AcquireSRWLockExclusive(&g_ldvb.wlock);
+        if (g_ldvb.from_stats) { g_ldvb.n = 0; g_ldvb.since_fit = 0; }
+        ReleaseSRWLockExclusive(&g_ldvb.wlock);
+        last_sync = 0;
+    }
+    if (FAILED(hr) || !fs.SyncQPCTime.QuadPart || !fs.SyncRefreshCount) {
+        if (g_ldvb.from_stats && now - good_us > 1e6) {      /* gone for a second: back to WaitForVBlank */
+            AcquireSRWLockExclusive(&g_ldvb.wlock);
+            g_ldvb.n = 0; g_ldvb.since_fit = 0; last_sync = 0;
+            InterlockedExchange(&g_ldvb.from_stats, 0);
+            ReleaseSRWLockExclusive(&g_ldvb.wlock);
+            fprintf(stderr, "[vblank-lock] frame statistics stopped: back to WaitForVBlank\n");
+            said = 0;
+        }
+        return;
+    }
+    good_us = now;
+    if (fs.SyncRefreshCount == last_sync) return;
+    const double t = (double)fs.SyncQPCTime.QuadPart * 1e6 / (double)f.QuadPart;
+    ld_pres_latency(fs.PresentCount, t);   /* fix 134 */
+    AcquireSRWLockExclusive(&g_ldvb.wlock);
+    if (!g_ldvb.from_stats || (long long)fs.SyncRefreshCount <= g_ldvb.idx ||
+        (long long)fs.SyncRefreshCount - g_ldvb.idx > 100000) {   /* switch-over, or a counter jump: new series */
+        g_ldvb.n = 0; g_ldvb.since_fit = 0;
+        InterlockedExchange(&g_ldvb.from_stats, 1);
+    } else if (g_ldvb.n && g_ldvb.period_us > 0) {
+        /* the time since the last sample has to match the refreshes counted: if not, another monitor's
+         * or another mode's counter took over without a DISJOINT -- do not fit the two together */
+        const double want = (double)((long long)fs.SyncRefreshCount - g_ldvb.idx) * g_ldvb.period_us;
+        if (fabs(t - g_ldvb.last_t - want) > 0.25 * g_ldvb.period_us) { g_ldvb.n = 0; g_ldvb.since_fit = 0; }
+    }
+    ldvb_add(t, (long long)fs.SyncRefreshCount);
+    ReleaseSRWLockExclusive(&g_ldvb.wlock);
+    last_sync = fs.SyncRefreshCount;
+    if (!said) { said = 1; fprintf(stderr, "[vblank-lock] vblank times from the swap chain's frame statistics "
+                                           "(LD_VBLANK_STATS=0 = WaitForVBlank)\n"); }
+}
+
+/* The fitted display grid: a recent vblank time (QPC us) and the refresh period. 0 until locked. */
+int rsx_live_draw_display_vblank(unsigned long long* vb_us, double* period_us)
+{
+    AcquireSRWLockShared(&g_ldvb.lock);
+    const int ok = g_ldvb.valid;
+    if (ok) {
+        if (vb_us) *vb_us = (unsigned long long)g_ldvb.base_us;
+        if (period_us) *period_us = g_ldvb.period_us;
+    }
+    ReleaseSRWLockShared(&g_ldvb.lock);
+    return ok;
+}
+
+static void ldvb_start(void)
+{
+    const char* e = getenv("LD_VBLANK_LOCK");
+    if (e && e[0] == '0') return;
+    InitializeSRWLock(&g_ldvb.lock);
+    InitializeSRWLock(&g_ldvb.wlock);
+    HANDLE th = CreateThread(NULL, 0, ldvb_thread, NULL, 0, NULL);
+    if (th) { SetThreadPriority(th, THREAD_PRIORITY_TIME_CRITICAL); CloseHandle(th); }
+    fprintf(stderr, "[vblank-lock] display vblank source %s\n", th ? "started" : "FAILED");
 }
 
