+static void pad_mouse_capture(int on)
+{
+    if ((s_mouse_cap != 0) == (on != 0)) return;
+    InterlockedExchange(&s_mouse_cap, on ? 1 : 0);
+    InterlockedExchange(&s_mouse_acc_x, 0);
+    InterlockedExchange(&s_mouse_acc_y, 0);
