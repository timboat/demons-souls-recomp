+/* Called at the present with the swap chain buffer in PRESENT state. */
+static void ld_overlay_draw(ID3D12Resource* bb, u32 bbi)
+{
+    if (!g_ld_ov_any || !bb) return;
+    char text[LD_OV_LINES][LD_OV_CHARS];
+    ld_ov_lock_init();
+    EnterCriticalSection(&g_ld_ov_lock);
+    memcpy(text, g_ld_ov_text, sizeof text);
+    LeaveCriticalSection(&g_ld_ov_lock);
+    const int ow = (int)g_ld_out_w, oh = (int)g_ld_out_h;
+    if (ow < 64 || oh < 64) return;
+    enum { MAXR = 3000 };
+    static D3D12_RECT fg[MAXR], bgr[LD_OV_LINES];
+    int nfg = 0, nbg = 0;
+    int y = oh / 30;
+    for (int li = 0; li < LD_OV_LINES; li++) {
+        const int len = (int)strlen(text[li]);
+        if (!len) continue;
+        int px = li == 0 ? oh / 200 : oh / 320;
+        if (px < 1) px = 1;
+        const int cw = 6 * px, w = len * cw - px, h = 7 * px;
+        const int x0 = (ow - w) / 2, pad = 2 * px;
+        if (nbg < LD_OV_LINES) {
+            D3D12_RECT r = { x0 - pad, y - pad, x0 + w + pad, y + h + pad };
+            if (r.left < 0) r.left = 0;
+            if (r.right > ow) r.right = ow;
+            bgr[nbg++] = r;
+        }
+        for (int ci = 0; ci < len; ci++) {
+            const unsigned char* gl = ld_ov_glyph(text[li][ci]);
+            if (!gl) continue;
+            const int gx = x0 + ci * cw;
+            for (int row = 0; row < 7; row++)
+                for (int col = 0; col < 5; ) {
+                    if (!(gl[row] & (0x10 >> col))) { col++; continue; }
+                    int end = col;
+                    while (end < 5 && (gl[row] & (0x10 >> end))) end++;
+                    if (nfg < MAXR) {
+                        D3D12_RECT r = { gx + col * px, y + row * px, gx + end * px, y + (row + 1) * px };
+                        if (r.left >= 0 && r.right <= ow && r.bottom <= oh) fg[nfg++] = r;
+                    }
+                    col = end;
+                }
+        }
+        y += h + 3 * pad;
+    }
+    if (!nfg && !nbg) return;
+    static const float bgc[4] = { 0.03f, 0.03f, 0.03f, 1.0f };
+    static const float fgc[4] = { 0.92f, 0.86f, 0.70f, 1.0f };
+    D3D12_RESOURCE_BARRIER kb = {0};
+    kb.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    kb.Transition.pResource = bb;
+    kb.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    kb.Transition.StateBefore = D3D12_RESOURCE_STATE_PRESENT;
+    kb.Transition.StateAfter = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    g.list->lpVtbl->ResourceBarrier(g.list, 1, &kb);
+    /* one rect per clear: a 58-rect ClearRenderTargetView failed fast (0xC0000409) on the swap chain buffer */
+    for (int i = 0; i < nbg; i++) g.list->lpVtbl->ClearRenderTargetView(g.list, rtv_handle(bbi), bgc, 1, &bgr[i]);
+    for (int i = 0; i < nfg; i++) g.list->lpVtbl->ClearRenderTargetView(g.list, rtv_handle(bbi), fgc, 1, &fg[i]);
