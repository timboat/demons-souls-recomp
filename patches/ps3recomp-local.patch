+    vm_write32(pInfo + 4, p->session);
+    vm_write32(pInfo + 8, ++p->atag);
+    vm_write32(pInfo + 12, 0);
+    vm_write32(pInfo + 16, (u32)((u64)pts >> 32));
+    vm_write32(pInfo + 20, (u32)pts);
+    if (live) sail_check_eos((int)(p - s_sail_players));
+    sail_unlock();
+    return CELL_OK;
+}
+
+/* cellSailSoundAdapterGetFormat(pSelf, pFormat) */
+s32 cellSailSoundAdapterGetFormat(u32 pSelf, u32 pFormat)
+{
+    sail_lock();
+    SailPlayer2* p = sail_player_of_adapter(pSelf, 2);
+    if (p && pFormat) sail_write_afmt(p, pFormat);
+    sail_unlock();
+    return p ? CELL_OK : (s32)CELL_SAIL_ERROR_INVALID_ARGUMENT;
+}
+
+s32 cellSailSoundAdapterUpdateAvSync(u32 pSelf, u32 tag, u64 time) { (void)pSelf; (void)tag; (void)time; return CELL_OK; }
+
+/* cellSailSoundAdapterFinalize(pSelf): cleanup callback. */
+s32 cellSailSoundAdapterFinalize(u32 pSelf)
+{
+    sail_lock();
+    SailAdapter* a = sail_adapter(pSelf);
+    if (a && a->fn[1]) ppu_guest_call(a->fn[1], a->arg, 0, 0, 0, 0, 0, 0, 0);
+    if (a) a->in_use = 0;
+    sail_unlock();
     return CELL_OK;
 }
 
