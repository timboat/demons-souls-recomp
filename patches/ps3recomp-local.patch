diff --git a/libs/audio/audio_rt_thread.c b/libs/audio/audio_rt_thread.c
new file mode 100644
index 0000000..0f80fdd
--- /dev/null
+++ b/libs/audio/audio_rt_thread.c
@@ -0,0 +1,34 @@
+/*
+ * ps3recomp - the audio mixing thread as a real-time thread (macOS)
+ *
+ * cellAudio.c's mixing thread has a deadline every 5.33 ms while the guest's
+ * threads keep every core busy. Windows runs it time-critical / MMCSS "Pro
+ * Audio"; on macOS the same is a time-constraint thread: a 5.33 ms period,
+ * about 1 ms of work, due within 2 ms. The kernel demotes a thread that
+ * overruns, so it cannot starve the machine. A file of its own because the
+ * Mach headers clash with names the runtime's headers define (thread_t,
+ * vm_protect). Elsewhere it does nothing.
+ */
+#if defined(__APPLE__)
+#include <mach/mach.h>
+#include <mach/mach_time.h>
+#include <mach/thread_policy.h>
+#include <pthread.h>
+#include <stdint.h>
+
+int ps3_audio_thread_realtime(void)
+{
+    mach_timebase_info_data_t tb;
+    if (mach_timebase_info(&tb) != KERN_SUCCESS || !tb.numer) return -1;
+    const double ns_to_abs = (double)tb.denom / (double)tb.numer;
+    thread_time_constraint_policy_data_t pol;
+    pol.period      = (uint32_t)(5333333.0 * ns_to_abs);
+    pol.computation = (uint32_t)(1000000.0 * ns_to_abs);
+    pol.constraint  = (uint32_t)(2000000.0 * ns_to_abs);
+    pol.preemptible = 1;
+    return thread_policy_set(pthread_mach_thread_np(pthread_self()), THREAD_TIME_CONSTRAINT_POLICY,
+                             (thread_policy_t)&pol, THREAD_TIME_CONSTRAINT_POLICY_COUNT) == KERN_SUCCESS ? 0 : -1;
+}
+#else
+int ps3_audio_thread_realtime(void) { return -1; }
+#endif
