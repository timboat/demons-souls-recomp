+ * (comma-separated, e.g. "HighGraphics"), and "rsx", this renderer's thread -- every 4 ms (at
+ * most 8 times a step), walks its stack with the x64 unwind tables and logs
+ * "# <us> stack <thread> <step age ms> <frames from other modules> <exe RVA> ..." (only frames
+ * in the exe; symbolise with llvm-symbolizer against the PDB). Nothing is written while a thread
+ * is suspended (it may hold the CRT or log lock). */
+static volatile LONG64 g_perf_step_t0;
+static struct { HANDLE h; char tag[32]; } g_perf_thr[6];
+static volatile LONG g_perf_n_thr = 1;   /* slot 0 is the main thread's (ps3_perf_step_begin) */
+static int g_perf_stacks = -1;
+static volatile int g_perf_started;   /* main registered: later threads append */
+static int perf_stacks_on(void)
+{
+    if (g_perf_stacks < 0) { const char* e = getenv("DES_PERF_STACKS"); g_perf_stacks = (e && *e == '1') ? 1 : 0; }
+    return g_perf_stacks;
+}
+static void perf_add_thread(const char* tag)
+{
+    const LONG i = InterlockedIncrement(&g_perf_n_thr) - 1;
+    if (i >= (LONG)(sizeof g_perf_thr / sizeof g_perf_thr[0])) { InterlockedDecrement(&g_perf_n_thr); return; }
+    HANDLE h = NULL;
+    DuplicateHandle(GetCurrentProcess(), GetCurrentThread(), GetCurrentProcess(), &h,
+                    THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_INFORMATION, FALSE, 0);
+    int k = 0;
+    for (; tag[k] && k < 31; k++) g_perf_thr[i].tag[k] = tag[k] == ' ' ? '_' : tag[k];
+    g_perf_thr[i].tag[k] = 0;
+    g_perf_thr[i].h = h;   /* last: the sampler skips a slot whose handle is not set yet */
+}
+/* A guest thread starting (sys_ppu_thread.c): watch it if DES_PERF_STACK_THREADS names it. */
+void ps3_perf_watch_thread(const char* name)
+{
+    if (!perf_stacks_on() || !name) return;
+    const char* list = getenv("DES_PERF_STACK_THREADS");
+    const size_t n = strlen(name);
+    for (const char* p = list; p && *p; ) {
+        const char* c = strchr(p, ',');
+        const size_t len = c ? (size_t)(c - p) : strlen(p);
+        /* A space in the name matches '_' in the list, as the log writes it ("spu__synth2_Group:0"). */
+        size_t k = 0;
+        if (len == n)
+            for (; k < n; k++) if (!(p[k] == name[k] || (name[k] == ' ' && p[k] == '_'))) break;
+        if (len == n && k == n) { perf_add_thread(name); return; }
+        p = c ? c + 1 : NULL;
+    }
+}
+/* The sampled thread's stack range, from its TEB (NT_TIB StackBase / StackLimit). */
+static int perf_stack_range(HANDLE h, ULONG64* lo, ULONG64* hi)
+{
+    typedef LONG (WINAPI *nqit_fn)(HANDLE, int, PVOID, ULONG, PULONG);
+    static nqit_fn nqit;
+    if (!nqit) nqit = (nqit_fn)(void*)GetProcAddress(GetModuleHandleA("ntdll.dll"), "NtQueryInformationThread");
+    struct { LONG exit_status; PVOID teb; ULONG_PTR pid, tid, affinity; LONG prio, base_prio; } tbi;
+    if (!nqit || nqit(h, 0 /* ThreadBasicInformation */, &tbi, sizeof tbi, NULL) < 0 || !tbi.teb) return 0;
+    const NT_TIB* tib = (const NT_TIB*)tbi.teb;
+    *hi = (ULONG64)tib->StackBase; *lo = (ULONG64)tib->StackLimit;
+    return *hi > *lo;
+}
+/* Walking a suspended thread's stack can meet frames without unwind data (lifted SPU code, a
+ * thread on its way out) and wander off: a read through a garbage stack pointer crashed the game
+ * inside ntdll (Demon's Souls NOTES fix 75). And the unwinder's own lookups take ntdll locks the
+ * suspended thread may hold. So: suspend, copy the top of its stack, resume, then unwind the copy
+ * -- the stack pointer has to stay inside the copy, and any fault just ends the sample. */
+static int perf_sample(HANDLE h, ULONG64 base, ULONG64* pcs, int max, int* other)
+{
+    enum { COPY = 64 * 1024 };
+    static ULONG64 buf[COPY / 8];   /* one sampler thread */
+    int n = 0; *other = 0;
+    CONTEXT c; memset(&c, 0, sizeof c); c.ContextFlags = CONTEXT_FULL;
+    ULONG64 lo = 0, hi = 0, rsp0 = 0, len = 0;
+    if (SuspendThread(h) == (DWORD)-1) return 0;
+    int ok = 0;
+    if (GetThreadContext(h, &c)) {
+        __try {
+            if (perf_stack_range(h, &lo, &hi) && c.Rsp >= lo && c.Rsp < hi) {
+                rsp0 = c.Rsp;
+                len = hi - rsp0 < COPY ? hi - rsp0 : COPY;
+                memcpy(buf, (const void*)rsp0, (size_t)len);
+                ok = 1;
+            }
+        } __except (EXCEPTION_EXECUTE_HANDLER) {
+            ok = 0;
+        }
+    }
+    ResumeThread(h);
+    if (!ok) return 0;
+    const ULONG64 b0 = (ULONG64)buf, b1 = b0 + len;
+    c.Rsp = b0;
+    if (c.Rbp >= rsp0 && c.Rbp < rsp0 + len) c.Rbp = b0 + (c.Rbp - rsp0);
+    __try {
+        for (int depth = 0; depth < 64 && c.Rip && n < max; depth++) {
+            if (c.Rsp < b0 || c.Rsp + 8 > b1) break;
+            ULONG64 img = 0;
+            PRUNTIME_FUNCTION fn = RtlLookupFunctionEntry(c.Rip, &img, NULL);
+            if (img == base) pcs[n++] = c.Rip - base;
+            else if (n == 0) (*other)++;
+            if (!fn) { c.Rip = *(ULONG64*)c.Rsp; c.Rsp += 8; continue; }   /* leaf */
+            PVOID hd; ULONG64 est;
+            RtlVirtualUnwind(UNW_FLAG_NHANDLER, img, c.Rip, fn, &c, &hd, &est, NULL);
+        }
+    } __except (EXCEPTION_EXECUTE_HANDLER) {
+        /* keep the frames found so far */
+    }
+    return n;
+}
+static DWORD WINAPI perf_stack_sampler(LPVOID unused)
+{
+    (void)unused;
+    const char* e = getenv("DES_PERF_STACK_MS");
+    const unsigned long long after = (unsigned long long)((e ? atof(e) : 28.0) * 1000.0);
+    const ULONG64 base = (ULONG64)GetModuleHandleW(NULL);
+    LONG64 sampled_step = 0; int n_this_step = 0; unsigned long long next_at = 0;
+    /* DES_PERF_STACK_EVERY=<ms>: also sample the watched threads other than main (rsx, named guest
+     * threads) every <ms>, late step or not -- a profile of where the renderer spends its frames. */
+    const char* ev = getenv("DES_PERF_STACK_EVERY");
+    const unsigned long long every = ev ? (unsigned long long)(atof(ev) * 1000.0) : 0;
+    unsigned long long next_every = 0;
+    for (;;) {
+        Sleep(1);
+        const LONG64 t0 = g_perf_step_t0;
+        if (!t0) continue;
+        const unsigned long long now = ps3_qpc_us();
+        if (every && now >= next_every) {
+            next_every = now + every;
+            const LONG nt = g_perf_n_thr;
+            for (LONG i = 1; i < nt; i++) {
+                if (!g_perf_thr[i].h) continue;
+                ULONG64 pcs[48]; int other;
+                const int n = perf_sample(g_perf_thr[i].h, base, pcs, 48, &other);
+                if (!n) continue;
+                char line[48 * 12 + 96];
+                int at = snprintf(line, sizeof line, "stack %s -1 %d", g_perf_thr[i].tag, other);
+                for (int k = 0; k < n && at < (int)sizeof line - 12; k++) at += snprintf(line + at, sizeof line - at, " %llX", pcs[k]);
+                ps3_perf_note("%s", line);
+            }
+        }
+        if (t0 != sampled_step) { sampled_step = t0; n_this_step = 0; next_at = (unsigned long long)t0 + after; }
+        if (now < next_at || n_this_step >= 8) continue;
+        const LONG nt = g_perf_n_thr;
+        for (LONG i = 0; i < nt; i++) {
+            if (!g_perf_thr[i].h) continue;
+            ULONG64 pcs[48]; int other;
+            const int n = perf_sample(g_perf_thr[i].h, base, pcs, 48, &other);
+            if (i == 0 && g_perf_step_t0 != t0) break;   /* the step ended meanwhile */
+            if (!n) continue;
+            char line[48 * 12 + 96];
+            int at = snprintf(line, sizeof line, "stack %s %.1f %d", g_perf_thr[i].tag,
+                              (now - (unsigned long long)t0) / 1000.0, other);
+            for (int k = 0; k < n && at < (int)sizeof line - 12; k++) at += snprintf(line + at, sizeof line - at, " %llX", pcs[k]);
+            ps3_perf_note("%s", line);
+        }
+        if (g_perf_step_t0 != t0) { n_this_step = 8; continue; }
+        n_this_step++; next_at = now + 4000;
+    }
+}
+/* Per-thread CPU for the perf log (Demon's Souls NOTES fix 58): once a second
+ * "# <us> thr <process %> <name>=<%> ..." -- the busiest host threads by name (ps3_thread_name:
+ * "ppu HighGraphics", "spu ...", the renderer), % of one core over that second, from
+ * QueryThreadCycleTime. A stretch of late frames then says which thread was saturated and which
+ * sat waiting. Threads that started and ended within the second are not seen. DES_PERF_THREADS=0
+ * = off. */
+static DWORD WINAPI perf_thread_cpu(LPVOID unused)
+{
+    (void)unused;
+    typedef HRESULT (WINAPI *get_desc_fn)(HANDLE, PWSTR*);
+    const get_desc_fn get_desc = (get_desc_fn)(void*)GetProcAddress(GetModuleHandleA("kernel32.dll"), "GetThreadDescription");
+    enum { MAXT = 512 };
+    static struct { DWORD tid; ULONG64 cyc; char name[40]; int seen; } tab[MAXT];
+    int nt = 0;
+    const DWORD pid = GetCurrentProcessId();
+    const unsigned long long c0 = __rdtsc(), q0 = ps3_qpc_us();
+    Sleep(50);
+    const double tsc_per_us = (double)(__rdtsc() - c0) / (double)(ps3_qpc_us() - q0);
+    unsigned long long last = ps3_qpc_us();
+    { typedef const char* (__cdecl *wine_ver_fn)(void);   /* the host: Windows, or Wine / Proton on Linux */
+      const wine_ver_fn wv = (wine_ver_fn)(void*)GetProcAddress(GetModuleHandleA("ntdll.dll"), "wine_get_version");
+      ps3_perf_note("info host %s %s", wv ? "wine" : "windows", wv ? wv() : "-"); }
+    ps3_perf_note("info cpu_clock %s", perf_cpu_from_times()
+        ? "thread_times (no cycle counter, e.g. Wine/Proton: per-frame CPU is coarse)" : "cycles");
+    ULONG64 proc_last = perf_process_cycles(tsc_per_us);
+    { extern void sys_timer_usleep_stats(unsigned long long*, unsigned long long*, unsigned long long*,
+                                         unsigned long long*);
+      unsigned long long z0, z1, z2, z3; sys_timer_usleep_stats(&z0, &z1, &z2, &z3); }   /* start-up's sleeps */
+    for (;;) {
+        Sleep(1000);
+        const unsigned long long now = ps3_qpc_us();
+        const double span = (double)(now - last) * tsc_per_us / 100.0;   /* cycles per 1% of a core */
+        last = now;
+        struct { char name[40]; double pct; } agg[64]; int na = 0;
+        for (int i = 0; i < nt; i++) tab[i].seen = 0;
+        HANDLE snap = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
+        if (snap == INVALID_HANDLE_VALUE) continue;
+        THREADENTRY32 te; te.dwSize = sizeof te;
+        for (BOOL ok = Thread32First(snap, &te); ok; ok = Thread32Next(snap, &te)) {
+            if (te.th32OwnerProcessID != pid) continue;
+            HANDLE h = OpenThread(THREAD_QUERY_LIMITED_INFORMATION, FALSE, te.th32ThreadID);
+            if (!h) continue;
+            const ULONG64 cyc = perf_thread_cycles(h, tsc_per_us);
+            int k = 0;
+            while (k < nt && tab[k].tid != te.th32ThreadID) k++;
+            if (k == nt && nt < MAXT) {
+                tab[nt].tid = te.th32ThreadID; tab[nt].cyc = cyc; tab[nt].name[0] = 0;
+                PWSTR w = NULL;
+                if (get_desc && SUCCEEDED(get_desc(h, &w)) && w) {
+                    int j = 0;
+                    for (; w[j] && j < 39; j++) tab[nt].name[j] = (w[j] == L' ' || w[j] > 126) ? '_' : (char)w[j];
+                    tab[nt].name[j] = 0; LocalFree(w); }
+                if (!tab[nt].name[0]) snprintf(tab[nt].name, sizeof tab[nt].name, "tid%lu", (unsigned long)te.th32ThreadID);
+                tab[nt].seen = 1; nt++; CloseHandle(h); continue;   /* new: counted from the next second */
+            }
+            CloseHandle(h);
+            if (k == nt) continue;
+            tab[k].seen = 1;
+            if (cyc < tab[k].cyc) continue;   /* a failed read (0, e.g. the thread just ended): skip, no wrap */
+            const double pct = (double)(cyc - tab[k].cyc) / span;
+            tab[k].cyc = cyc;
+            int a = 0;
+            while (a < na && strcmp(agg[a].name, tab[k].name)) a++;
+            if (a == na && na < 64) { memcpy(agg[na].name, tab[k].name, 40); agg[na].pct = 0; na++; }
+            if (a < na) agg[a].pct += pct;
+        }
+        CloseHandle(snap);
+        /* threads gone since the last snapshot: drop them */
+        for (int i = 0; i < nt; ) { if (!tab[i].seen) { tab[i] = tab[--nt]; } else i++; }   /* also 0-CPU ones */
+        const ULONG64 proc = perf_process_cycles(tsc_per_us);
+        const double proc_pct = (double)(proc - proc_last) / span; proc_last = proc;
+        char line[1024]; int len = snprintf(line, sizeof line, "thr %.0f", proc_pct);
+        for (int shown = 0; shown < 10; shown++) {
+            int best = -1;
+            for (int a = 0; a < na; a++) if (agg[a].pct >= 2.0 && (best < 0 || agg[a].pct > agg[best].pct)) best = a;
+            if (best < 0) break;
+            len += snprintf(line + len, sizeof line - len, " %s=%.0f", agg[best].name, agg[best].pct);
+            agg[best].pct = -1.0;
+            if (len >= (int)sizeof line - 64) break;
+        }
+        ps3_perf_note("%s", line);
+        { extern void sys_timer_usleep_stats(unsigned long long*, unsigned long long*, unsigned long long*,
+                                             unsigned long long*);
+          unsigned long long n, req, over, late;   /* "slp <sleeps> <us asked> <us late> <1 ms+ late>" (fix 79) */
+          sys_timer_usleep_stats(&n, &req, &over, &late);
+          if (n) ps3_perf_note("slp %llu %llu %llu %llu", n, req, over, late); }
+    }
+    return 0;
+}
+
+void ps3_perf_step_begin(void)
+{
+    static int started, thr_started;
+    if (!thr_started) {
+        thr_started = 1;
+        const char* e = getenv("DES_PERF_THREADS");
+        if (!(e && *e == '0')) { HANDLE t = CreateThread(NULL, 0, perf_thread_cpu, NULL, 0, NULL); if (t) CloseHandle(t); }
+    }
+    if (!perf_stacks_on()) return;
+    if (!started) {
+        started = 1;
+        /* The main thread goes in slot 0, kept free for it (no shuffle racing a thread that
+         * registers at the same moment). */
+        { HANDLE h = NULL;
+          DuplicateHandle(GetCurrentProcess(), GetCurrentThread(), GetCurrentProcess(), &h,
+                          THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_INFORMATION, FALSE, 0);
+          memcpy(g_perf_thr[0].tag, "main", 5);
+          g_perf_thr[0].h = h; }
+        g_perf_started = 1;
+        HANDLE t = CreateThread(NULL, 0, perf_stack_sampler, NULL, 0, NULL);
+        if (t) { SetThreadPriority(t, THREAD_PRIORITY_TIME_CRITICAL); CloseHandle(t); }
+        ps3_perf_note("info exe_base %llX", (unsigned long long)(ULONG64)GetModuleHandleW(NULL));
+    }
+    g_perf_step_t0 = (LONG64)ps3_qpc_us();
+}
