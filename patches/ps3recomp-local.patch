+#define OSK_ID_EDIT 100
+static WCHAR s_osk_prompt[CELL_OSK_MAX_TEXT_LENGTH + 1];
+static WCHAR s_osk_init[CELL_OSK_MAX_TEXT_LENGTH + 1];
+static u32   s_osk_limit;
+static HWND  s_osk_hwnd;
+static HFONT s_osk_font;
+
+static void osk_window_done(HWND hwnd, int ok)
+{
+    if (ok) {
+        WCHAR buf[CELL_OSK_MAX_TEXT_LENGTH + 1];
+        int n = GetDlgItemTextW(hwnd, OSK_ID_EDIT, buf, CELL_OSK_MAX_TEXT_LENGTH + 1);
+        if (n < 0) n = 0;
+        if (s_osk_limit && (u32)n > s_osk_limit) n = (int)s_osk_limit;
+        for (int i = 0; i < n; i++) s_result_text[i] = (CellOskDialogChar)buf[i];
+        s_result_text[n] = 0;
+        s_result_length = (u32)n;
+        s_result_code = CELL_OSK_DIALOG_INPUT_FIELD_RESULT_OK;
+        char narrow[CELL_OSK_MAX_TEXT_LENGTH + 1];
+        osk_utf16_to_ascii(s_result_text, narrow, CELL_OSK_MAX_TEXT_LENGTH);
+        printf("[cellOskDialog] typed \"%s\" (%d chars)\n", narrow, n);
+    } else {
+        s_result_code = CELL_OSK_DIALOG_INPUT_FIELD_RESULT_CANCELED;
+        printf("[cellOskDialog] text box cancelled\n");
+    }
+    fflush(stdout);
+    DestroyWindow(hwnd);
