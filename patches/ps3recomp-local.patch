+/* The swap chain follows the window (fix 74): before, it stayed at the game's 1280x720 and DXGI
+ * stretched it to any window size or borderless fullscreen (also the aspect ratio), which also threw
+ * a higher internal resolution away. A new client size, unchanged for 3 presents (a window being
+ * dragged), waits for the GPU and resizes the buffers. LD_SWAP_RESIZE=0 = the old fixed size. */
+static void ld_swap_follow_window(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("LD_SWAP_RESIZE"); on = !(e && e[0] == '0'); }
+    if (!on || !g_ld_hwnd || !g.swap) return;
+    RECT rc;
+    if (!GetClientRect(g_ld_hwnd, &rc)) return;
+    const u32 w = (u32)rc.right, h = (u32)rc.bottom;
+    static u32 pend_w, pend_h, pend_n;
+    if (!w || !h || (w == g_ld_out_w && h == g_ld_out_h)) { pend_n = 0; return; }   /* minimised / same */
+    if (w != pend_w || h != pend_h) { pend_w = w; pend_h = h; pend_n = 0; }
+    if (++pend_n < 3) return;
+    pend_n = 0;
+    ld_pipe_wait(g.fence_value);   /* every submitted frame done: nothing references the buffers */
