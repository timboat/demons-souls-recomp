+/* Accumulated counts -> right-stick deflection for one report (when the camera does not take them itself: lock-on,
+ * aiming). The game reads the stick through a 0.37 RADIAL deadzone, (m - 0.37) / 0.58 (func_001C3000): the wanted
+ * output v = counts * PAD_MOUSE_SENS (default 0.04 per count) is emitted as magnitude 0.37 + 0.58 |v| in its
+ * direction, |v| capped at 0.97 (byte rounding stays below the camera's 0.998 hi-speed threshold), the rest carried (at most two reports'
+ * worth, so a flick does not keep turning). PAD_MOUSE_DEADZONE=<0..0.9> for other titles (default 0.37). */
+static void pad_mouse_take(int* rx, int* ry)
+{
+    static double sens = -1, dz = 0.37, span = 0.58;
+    if (sens < 0) {
+        const char* s = getenv("PAD_MOUSE_SENS"); sens = s ? atof(s) : 0.04; if (sens <= 0) sens = 0.04;
+        const char* d = getenv("PAD_MOUSE_DEADZONE"); if (d) { dz = atof(d); if (dz < 0 || dz > 0.9) dz = 0.37; }
+    }
+    const LONG cx = InterlockedExchange(&s_mouse_acc_x, 0), cy = InterlockedExchange(&s_mouse_acc_y, 0);
+    *rx = *ry = 0;
+    if (!cx && !cy) return;
+    const double vx = cx * sens, vy = cy * sens, len = sqrt(vx * vx + vy * vy), cap = 0.97;   /* byte rounding margin */
+    const double use = len > cap ? cap / len : 1.0;   /* fraction of the counts reported now */
+    if (use < 1.0) {
+        const double keep = 1.0 - use, lim = 2.0 * cap / sens;
+        double kx = cx * keep, ky = cy * keep;
+        if (kx > lim) kx = lim; if (kx < -lim) kx = -lim;
+        if (ky > lim) ky = lim; if (ky < -lim) ky = -lim;
+        InterlockedAdd(&s_mouse_acc_x, (LONG)kx);
+        InterlockedAdd(&s_mouse_acc_y, (LONG)ky);
+    }
+    const double m = dz + span * (len * use), dirx = vx / len, diry = vy / len;   /* (m - 0.37) / 0.58 = |v| */
+    *rx = (int)(dirx * m * 127.0 + (dirx < 0 ? -0.5 : 0.5));
+    *ry = (int)(diry * m * 127.0 + (diry < 0 ? -0.5 : 0.5));
+}
