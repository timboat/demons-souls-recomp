+                                                     (ld_frame_latency() ? DXGI_SWAP_CHAIN_FLAG_FRAME_LATENCY_WAITABLE_OBJECT : 0));
+    for (u32 i = 0; i < n; i++) {
+        g.swap->lpVtbl->GetBuffer(g.swap, i, &IID_ID3D12Resource, (void**)&g.backbuf[i]);
+        g.dev->lpVtbl->CreateRenderTargetView(g.dev, g.backbuf[i], NULL, rtv_handle(i));
+    }
+    if (SUCCEEDED(hr)) { g_ld_out_w = w; g_ld_out_h = h; }
+    fprintf(stderr, "[present] swap chain %ux%u%s\n", w, h, SUCCEEDED(hr) ? "" : " -- resize FAILED");
+    if (FAILED(hr)) on = 0;
