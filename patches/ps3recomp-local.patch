+void ps3_hot_thread(int slot)
+{
+    if (slot < 0 || slot >= HOT_SLOTS) return;
+    if (t_hot_slot == slot && t_hot_gen == __atomic_load_n(&s_hot_gen[slot], __ATOMIC_RELAXED)) return;
