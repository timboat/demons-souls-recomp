+/* The vertex program's length, FNV hash, texture-fetch mask, branch-bit use and input mask depend
+ * only on the vp[] words: recomputed only when the start slot changes or a program word was written
+ * since (rsx_dispatch_vp_generation; every vp[] write bumps it). The byte-wise hash ran twice per draw
+ * over the whole program -- ~4% of the renderer thread by the Boletaria scaffolding (NOTES fix 48).
+ * fix 115: one memo for get_pso and ld_current_vertex_layout, which re-ran the input analysis
+ * (rsx_vp_analyze_inputs) and the size walk on every draw; the branch-bit scan joins it. Same values
+ * as before. Caller checked start < RSX_DSP_VP_INSTR. */
+static struct { u32 valid, start, gen, instrs, txl, in_mask; int brb; u64 hash; } vpm;
+static void ld_vpm_update(u32 start)
+{
+    extern u32 rsx_dispatch_vp_generation;
+    const u32 gen = rsx_dispatch_vp_generation;
+    if (vpm.valid && vpm.start == start && vpm.gen == gen) return;
+    const u8* uc = (const u8*)(g.rsx.vp + start * 4);
+    vpm.instrs = rsx_vp_program_size_instrs(uc, (RSX_DSP_VP_INSTR - start) * 16);
+    vpm.hash = fnv1a(uc, vpm.instrs * 16, 1469598103934665603ull);
+    vpm.txl = vp_txl_unit_mask(uc, vpm.instrs);
+    vpm.brb = rsx_vp_uses_branch_bits(uc, vpm.instrs * 16);
+    rsx_vp_input_analysis analysis = {0xFFFFu, 0};
+    if (!vpm.instrs ||
+        rsx_vp_analyze_inputs(uc, vpm.instrs * 16, &analysis) != (int)vpm.instrs ||
+        !analysis.exact)
+        analysis.input_mask = 0xFFFFu;
+    vpm.in_mask = analysis.input_mask;
+    vpm.start = start; vpm.gen = gen; vpm.valid = 1;
+}
