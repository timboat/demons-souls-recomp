+s32 cellSpursQueuePopBody(u64 queue_ea, u64 buffer_ea, u32 isPeek, u32 isBlocking)
+{
+    /* Ported from libsre (NID 0x91066667); layout as _cellSpursQueueInitialize.
+     * Phase 1 takes the element: the pop word is set to ~pop ("pop in progress")
+     * once the queue is seen non-empty. Phase 2 stores pop+1 (or pop, for a peek)
+     * and, if the queue had been full while an SPU producer registered as waiting
+     * (+0x30 flag, +0x31 its task id), signals that task. Both are atomic on the
+     * queue's line against the SPU's GETLLAR/PUTLLC, so they run under the
+     * lock-line lock and drop SPU reservations on it.
+     * Deviation: an empty blocking pop polls instead of sleeping on the lv2 event
+     * queue cellSpursQueueAttachLv2EventQueue would create (that HLE creates
+     * none). The pop word is never left "in progress" while polling, so the SPU
+     * producer never tries to wake us through an event port. */
+    const uint32_t q = (uint32_t)queue_ea, dst = (uint32_t)buffer_ea;
+    if (!q || !dst)                 return CELL_SPURS_TASK_ERROR_NULL_POINTER;
+    if (q & 0x7F)                   return CELL_SPURS_TASK_ERROR_ALIGN;
+    if (vm_read32(q + 0x1C) != 1)   return CELL_SPURS_TASK_ERROR_PERM;   /* SPU2PPU only */
+    const int32_t depth = (int32_t)vm_read32(q + 0x0C);
+    const uint32_t size = vm_read32(q + 0x08);
+    const uint32_t buf  = (uint32_t)vm_read64(q + 0x10);
+    if (depth <= 0) return CELL_SPURS_TASK_ERROR_STAT;
+    { static int dbg = -1; static unsigned long n;   /* QUEUE_DBG=1: the call and the indices it sees */
+      if (dbg < 0) dbg = getenv("QUEUE_DBG") ? 1 : 0;
+      if (dbg && (n++ < 24 || n % 50000 == 0))
+          fprintf(stderr, "[queue] pop #%lu q=0x%08X peek=%u block=%u pop=0x%08X push=0x%08X\n", n, q,
+                  isPeek, isBlocking, vm_read32(q + 0x00), vm_read32(q + 0x04)); }
+
+    int32_t pop, slot;
+    /* Under the lock-line lock only raw guest accesses: vm_write32 takes that
+     * lock itself, and taking it twice deadlocked this thread the first time the
+     * queue was non-empty. ef_line_end drops SPU reservations and unlocks. */
+    for (;;) {
+        spu_lockline_lock();
+        pop = (int32_t)lfq_r32(q + 0x00);
+        if (pop < 0) { spu_lockline_unlock(); return CELL_SPURS_TASK_ERROR_BUSY; }
+        int32_t push = (int32_t)lfq_r32(q + 0x04);
+        if (push < 0) push = ~push;
+        int32_t count = push - pop;
+        if (push < pop) count += 2 * depth;
+        if (count > 0) {
+            slot = pop >= depth ? pop - depth : pop;
+            ef_w16(q + 0x00, (u16)((uint32_t)~pop >> 16)); ef_w16(q + 0x02, (u16)~pop);
+            ef_line_end(q);
+            break;
+        }
+        spu_lockline_unlock();
+        if (!(isBlocking & 0xFF)) return CELL_SPURS_TASK_ERROR_AGAIN;
+        { static unsigned long w; if ((++w & 0xFFFFF) == 1 && getenv("QUEUE_DBG"))
+              fprintf(stderr, "[queue] blocking pop waiting #%lu q=0x%08X pop=%d push=0x%08X depth=%d\n",
+                      w, q, pop, vm_read32(q + 0x04), depth); }
+        Sleep(0);
+    }
+
+    memcpy(vm_base + dst, vm_base + buf + size * (uint32_t)slot, size);
+
+    int signal = 0; uint32_t waiter = 0;
+    spu_lockline_lock();
+    {
+        pop = ~(int32_t)lfq_r32(q + 0x00);
+        int32_t push = (int32_t)lfq_r32(q + 0x04);
+        if (push < 0) push = ~push;
+        int32_t count = push - pop;
+        if (push < pop) count += 2 * depth;
+        if (vm_base[q + 0x30] != 0) signal = (count == depth);
+        waiter = vm_base[q + 0x31];
+        if (!(isPeek & 0xFF)) { pop += 1; if (pop >= 2 * depth) pop = 0; }
+        ef_w16(q + 0x00, (u16)((uint32_t)pop >> 16)); ef_w16(q + 0x02, (u16)pop);
+    }
+    ef_line_end(q);
+    if (signal && !(isPeek & 0xFF)) {
+        const uint32_t taskset = (uint32_t)vm_read64(q + 0x60);
+        if (taskset) spu_taskset_signal_task(taskset, waiter);
+    }
+    { static int pl = -1; if (pl < 0) pl = getenv("LFQ_POPLOG") ? 1 : 0;   /* every element popped */
+      if (pl) { fprintf(stderr, "[queue] popped q=0x%08X slot=%d:", q, slot);
+                for (uint32_t o = 0; o < size && o < 32; o += 4) fprintf(stderr, " %08X", vm_read32(dst + o));
+                fprintf(stderr, "%s\n", signal ? " (signalled producer)" : ""); } }
+    return CELL_OK;
+}
+
+s32 _cellSpursLFQueuePushBody(u64 queue_ea, u64 buffer_ea, u32 isBlocking)
+{
+    const uint32_t q = (uint32_t)queue_ea, src = (uint32_t)buffer_ea;
+    if (!q || !src)                 return CELL_SPURS_TASK_ERROR_NULL_POINTER;
+    if ((q & 127) || (src & 15))    return CELL_SPURS_TASK_ERROR_ALIGN;
+    if (lfq_r32(q + 0x24) != 2) {   /* only PPU2SPU is ported (ANY2ANY needs the *2 variants) */
+        static int _w = 0;
+        if (PS3_LOG_FIRST(_w, 4))
+            printf("[cellSpurs] _LFQueuePushBody q=0x%08X direction %u not supported\n", q, lfq_r32(q + 0x24));
+        return CELL_SPURS_TASK_ERROR_PERM;
+    }
+    s32 pos;
+    s32 rc = lfq_get_push_pointer(q, isBlocking, &pos);
+    if (rc) return rc;
+
+    const s32 depth = (s32)lfq_r32(q + 0x14), size = (s32)lfq_r32(q + 0x10);
+    const uint32_t buf = lfq_r32(q + 0x1C) & ~1u;
+    memcpy(vm_base + buf + (u32)size * (u32)(pos >= depth ? pos - depth : pos), vm_base + src, (size_t)size);
+    { static int dbg = -1; if (dbg < 0) dbg = getenv("LFQ_DBG") ? 1 : 0;
+      if (dbg) { fprintf(stderr, "[lfq] elem q=0x%08X pos=%d:", q, pos);
+                 for (s32 o = 0; o < size && o < 64; o += 4) fprintf(stderr, " %08X", lfq_r32(src + (u32)o));
+                 fprintf(stderr, "\n"); } }
+    lfq_complete_push_pointer(q, pos);
+
+    static int _n = 0;
+    if (PS3_LOG_FIRST(_n, 8))
+        printf("[cellSpurs] _LFQueuePushBody(q=0x%08X buf=0x%08X blocking=%u) -> slot %d\n", q, src, isBlocking, pos);
+    return CELL_OK;
+}
