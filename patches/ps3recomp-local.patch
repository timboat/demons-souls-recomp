+/* ---------------------------------------------------------------------------
+ * Converted-vertex cache (LD_VCACHE=0 turns it off).
+ *
+ * Most of a frame's draws are static meshes whose guest vertex and index bytes
+ * do not change from frame to frame, yet every draw re-gathered its indices,
+ * de-duplicated them and decoded every attribute of every vertex to floats --
+ * about half of the RSX thread's time in Demon's Souls. A draw is described
+ * by its key (attribute registers, bases, batches, primitive, restart rule and
+ * the index bytes themselves); a hit re-hashes the guest vertex ranges the
+ * converted copy was made from and, when they are unchanged, uploads the
+ * stored vertices and topology indices instead of converting again.
+ * -----------------------------------------------------------------------*/
+#define LD_VC_SLOTS      8192u
+#define LD_VC_MAX_RANGES 16u
+#define LD_VC_BUDGET     (384ull << 20)
+typedef struct {
+    u64 key, src_hash;
+    const u8* range_p[LD_VC_MAX_RANGES];
+    u32 range_n[LD_VC_MAX_RANGES];
+    u32 n_ranges;
+    u32 n_verts, n_source_refs, n_tri, indexed, stride;
+    u8* verts;          /* n_verts * stride bytes, then n_tri u32 indices */
+    u64 bytes;
+    u32 last_frame;
+    u32 vca_off;        /* gpu: offset of verts in the GPU-visible arena */
+    u8 vca_cls, gpu;    /* gpu: verts live in the arena (write-only, never read back) */
+    u8 stable;          /* consecutive full source checks that found no change */
