+        /* rows tightly packed, 4 bytes a pixel, in the pix_fmt ffmpeg was told */
+        for (u32 y = 0; y < g_ldv.h; y++) {
+            const u8* srow = px + (size_t)y * g_ldv.src_pitch;
+            u8* drow = last + (size_t)y * g_ldv.w * 4;
