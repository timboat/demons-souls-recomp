+/* fix 117: the words of one FIFO method header, for the live renderer's batched path (rsx_live_draw.c
+ * ld_method_run). Word k is method sb | (method + 4k), or sb | method when !incr, with its argument read
+ * big-endian from be[k] when it is processed. A word rsx_dispatch_method would only store -- every
+ * method but the ones below -- is stored here directly (seen[] and regs[], exactly its first two
+ * statements); the transform-program and transform-constant upload windows run their own statements
+ * (the constant window only while RSX_CONST_LOG is off). Everything else goes through
+ * rsx_dispatch_method, and the run returns right after it, since such a word may call a sink (draw,
+ * clear, flip, immediate vertex) or change the immediate-mode state. It stops before a word when
+ * *stop_if_set != 0 or *stop_if_clear == 0. Returns the number of words done. */
+static inline u32 dsp_be32(const u32* p)
+{
+    u32 r; memcpy(&r, p, 4);
+#if defined(_MSC_VER) && !defined(__clang__)
+    return _byteswap_ulong(r);
+#else
+    return __builtin_bswap32(r);
+#endif
+}
+static inline u32 dsp_kind(u32 m)   /* 0 store only, 1 constant window, 2 program window, 3 anything else */
+{
+    if (m >= 0x2000u) return (m == M_GCM_FLIP_HEAD_0 || m == M_GCM_FLIP_HEAD_1 || m == M_GCM_DRIVER_FLIP) ? 3u : 0u;
+    if ((m >= 0x1500u && m < 0x1A00u) || (m >= 0x1E40u && m < 0x1E80u) || (m >= 0x0A80u && m < 0x0B00u) ||
+        m == 0x1C0Cu || m == M_CLEAR_BUFFERS)   /* immediate-mode folds and vertices, BEGIN_END, batches, */
+        return 3u;                              /* INLINE_ARRAY (all inside 0x1500..0x19FF), CLEAR       */
+    if (m >= M_VP_UPLOAD_CONST && m < M_VP_UPLOAD_CONST + 32 * 4) return 1u;
+    if (m >= M_VP_UPLOAD_INST && m < M_VP_UPLOAD_INST + 32 * 4) return 2u;
+    return 0u;
+}
+u32 rsx_dispatch_method_run(rsx_dispatch* rsx, u32 sb, u32 method, int incr, const u32* be, u32 count,
+                            const volatile int* stop_if_set, const volatile int* stop_if_clear)
+{
+    if (s_cl_lo == -2) { const char* e = getenv("RSX_CONST_LOG"); s_cl_lo = -1;
+                         if (e) sscanf(e, "%d,%d", &s_cl_lo, &s_cl_hi); }
+    for (u32 k = 0; k < count; k++) {
+        if ((stop_if_set && *stop_if_set) || (stop_if_clear && !*stop_if_clear)) return k;
+        const u32 raw = sb | (incr ? method + 4u * k : method);
+        const u32 arg = dsp_be32(be + k);
+        const u32 m = raw & 0xFFFFC, idx = m >> 2;
+        const u32 kd = idx < RSX_DSP_NUM_REGS ? dsp_kind(m) : 3u;   /* out of range: the logged drop */
+        if (kd == 0) { rsx->seen[idx]++; rsx->regs[idx] = arg; continue; }
+        if (kd == 1 && s_cl_lo < 0) {
+            rsx->seen[idx]++; rsx->regs[idx] = arg;
+            const u32 word = (m - M_VP_UPLOAD_CONST) >> 2;
+            const u32 slot = rsx->regs[M_VP_UPLOAD_CONST_ID >> 2] + (word >> 2);
+            if (slot < RSX_DSP_NUM_CONSTANTS) rsx->constants[slot][word & 3] = arg;
+            continue;
+        }
