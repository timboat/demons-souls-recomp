+static DWORD WINAPI ldv_writer(LPVOID unused)
+{
+    (void)unused;
+    const size_t fb = (size_t)g_ldv.w * g_ldv.h * 4;
+    u8* last = (u8*)malloc(fb); u8* conv = (u8*)malloc(fb);
+    u64 last_t = 0; double grid = 0; int have = 0;
+    const double step = 1e6 / g_ldv.fps;
+    for (;;) {
+        AcquireSRWLockExclusive(&g_ldv.lock);
+        while (g_ldv.q_head == g_ldv.q_tail)
+            SleepConditionVariableSRW(&g_ldv.cv, &g_ldv.lock, INFINITE, 0);
+        const u32 k = g_ldv.q_head % LD_VIDEO_QUEUE;
+        ReleaseSRWLockExclusive(&g_ldv.lock);
+        u8* px = g_ldv.q[k].px; const u64 t = g_ldv.q[k].t_us;
+        if (!have) fprintf(stderr, "[video] first frame qpc_us=%llu\n", (unsigned long long)t);
+        if (have) {                      /* the previous frame was on screen from last_t until t */
+            if (grid < (double)last_t) grid = (double)last_t;
+            while (grid < (double)t) {
+                if (fwrite(last, 1, fb, g_ldv.pipe) != fb) { fprintf(stderr, "[video] ffmpeg pipe closed\n"); return 0; }
+                g_ldv.written++; grid += step;
