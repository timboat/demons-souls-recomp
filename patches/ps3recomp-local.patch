+            DeleteDC(mdc); ReleaseDC(hwnd, sdc);
+        }
+        PostMessageW(hwnd, WM_COMMAND, IDOK, 0);
+        return 0;
+    }
+    case WM_CLOSE:
+        osk_window_done(hwnd, 0);
+        return 0;
+    case WM_DESTROY:
+        PostQuitMessage(0);
+        return 0;
+    }
+    return DefWindowProcW(hwnd, msg, wp, lp);
+}
