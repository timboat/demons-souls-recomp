diff --git a/runtime/diag/stall_sampler.c b/runtime/diag/stall_sampler.c
new file mode 100644
index 0000000..2b16e6c
--- /dev/null
+++ b/runtime/diag/stall_sampler.c
@@ -0,0 +1,264 @@
+/*
+ * ps3recomp - stall sampler (macOS): what every thread does while the guest is frozen
+ *
+ * PS3_STALL_SAMPLE=<ms> starts a watchdog thread that reads the guest's flip
+ * count (cellGcm_flip_request_count) every 2 ms. When no flip has come for
+ * <ms> milliseconds it samples the stack of every other thread of the
+ * process every 5 ms -- suspend, read pc/lr/fp, walk the frame-pointer chain,
+ * resume -- until flips resume (or 5 s pass), then prints to stderr the most
+ * frequent stacks of each thread, symbolized with dladdr:
+ *
+ *   [stall] 1840 ms without a flip (t=12.345 s), 368 samples
+ *   [stall]   HighGraphics  92%  sys_cond_wait < func_009E0370 < func_00B498E8 < ...
+ *
+ * A sampling profile of the whole run says where time goes on average; a
+ * stall is one event, and only stacks taken during it say who held it up.
+ * The 70-200 ms hitches and the multi-second freezes seen in Demon's Souls
+ * on the Mac have no span of their own in ps3_ftrace (PPU work is not traced).
+ *
+ * A file of its own because the Mach headers clash with names the runtime's
+ * headers define. Elsewhere it does nothing. arm64 and x86_64 both keep frame
+ * pointers on macOS, so the chain walk needs no unwinder.
+ */
+#if defined(__APPLE__)
+#include <dlfcn.h>
+#include <mach/mach.h>
+#include <mach/mach_vm.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+extern unsigned cellGcm_flip_request_count(void);
+
+#define SS_MAX_THREADS 128
+#define SS_DEPTH       10
+#define SS_MAX_STACKS  512
+
+typedef struct {
+    uint64_t tid;
+    uintptr_t pc[SS_DEPTH];
+    int n;
+    unsigned count;
+    char name[48];
+} ss_stack;
+
+static ss_stack s_st[SS_MAX_STACKS];
+static int s_nst;
+static unsigned s_samples_per_tid[SS_MAX_THREADS];
+static uint64_t s_tids[SS_MAX_THREADS];
+static char s_tnames[SS_MAX_THREADS][48];
+static int s_ntid;
+
+static double ss_now(void)
+{
+    struct timespec t;
+    clock_gettime(CLOCK_MONOTONIC, &t);
+    return (double)t.tv_sec + (double)t.tv_nsec / 1e9;
+}
+
+static int ss_tid_index(uint64_t tid, const char* name)
+{
+    for (int i = 0; i < s_ntid; i++) if (s_tids[i] == tid) return i;
+    if (s_ntid >= SS_MAX_THREADS) return -1;
+    s_tids[s_ntid] = tid;
+    snprintf(s_tnames[s_ntid], sizeof s_tnames[0], "%s", name);
+    s_samples_per_tid[s_ntid] = 0;
+    return s_ntid++;
+}
+
+static void ss_record(uint64_t tid, const char* name, const uintptr_t* pc, int n)
+{
+    for (int i = 0; i < s_nst; i++)
+        if (s_st[i].tid == tid && s_st[i].n == n && !memcmp(s_st[i].pc, pc, (size_t)n * sizeof *pc)) {
+            s_st[i].count++; return;
+        }
+    if (s_nst >= SS_MAX_STACKS) return;
+    ss_stack* s = &s_st[s_nst++];
+    s->tid = tid; s->n = n; s->count = 1;
+    memcpy(s->pc, pc, (size_t)n * sizeof *pc);
+    snprintf(s->name, sizeof s->name, "%s", name);
+}
+
+/* One stack of thread t: suspended for the few microseconds of the walk. */
+static void ss_sample_thread(thread_act_t t)
+{
+    pthread_t pt = pthread_from_mach_thread_np(t);
+    char name[48] = "";
+    if (pt) pthread_getname_np(pt, name, sizeof name);
+    uint64_t tid = 0;
+    thread_identifier_info_data_t info; mach_msg_type_number_t ic = THREAD_IDENTIFIER_INFO_COUNT;
+    if (thread_info(t, THREAD_IDENTIFIER_INFO, (thread_info_t)&info, &ic) == KERN_SUCCESS) tid = info.thread_id;
+    uintptr_t lo = 0, hi = 0;
+    if (pt) { hi = (uintptr_t)pthread_get_stackaddr_np(pt); lo = hi - pthread_get_stacksize_np(pt); }
+    if (thread_suspend(t) != KERN_SUCCESS) return;
+    uintptr_t pc[SS_DEPTH]; int n = 0;
+#if defined(__arm64__) || defined(__aarch64__)
+    arm_thread_state64_t st; mach_msg_type_number_t sc = ARM_THREAD_STATE64_COUNT;
+    if (thread_get_state(t, ARM_THREAD_STATE64, (thread_state_t)&st, &sc) == KERN_SUCCESS) {
+        pc[n++] = (uintptr_t)arm_thread_state64_get_pc(st);
+        uintptr_t lr = (uintptr_t)arm_thread_state64_get_lr(st);
+        uintptr_t fp = (uintptr_t)arm_thread_state64_get_fp(st);
+        if (lr && n < SS_DEPTH) pc[n++] = lr & 0x0000FFFFFFFFFFFFull;
+#else
+    x86_thread_state64_t st; mach_msg_type_number_t sc = x86_THREAD_STATE64_COUNT;
+    if (thread_get_state(t, x86_THREAD_STATE64, (thread_state_t)&st, &sc) == KERN_SUCCESS) {
+        pc[n++] = (uintptr_t)st.__rip;
+        uintptr_t fp = (uintptr_t)st.__rbp;
+#endif
+        /* Only inside the thread's own stack, and through mach_vm_read_overwrite:
+         * a thread caught mid-prologue or in code without a frame record
+         * leaves fp pointing anywhere, and a plain load there faults. */
+        while (n < SS_DEPTH && hi && fp && (fp & 7u) == 0 && fp >= lo && fp + 16 <= hi) {
+            uintptr_t f[2]; mach_vm_size_t got = 0;
+            if (mach_vm_read_overwrite(mach_task_self(), (mach_vm_address_t)fp, sizeof f,
+                                       (mach_vm_address_t)(uintptr_t)f, &got) != KERN_SUCCESS ||
+                got != sizeof f) break;
+            const uintptr_t ret = f[1] & 0x0000FFFFFFFFFFFFull;
+            const uintptr_t next = f[0];
+            if (!ret) break;
+            pc[n++] = ret;
+            if (next <= fp) break;
+            fp = next;
+        }
+    }
+    thread_resume(t);
+    if (n == 0) return;
+    const int ti = ss_tid_index(tid, name);
+    if (ti >= 0) s_samples_per_tid[ti]++;
+    ss_record(tid, name, pc, n);
+}
+
+static const char* ss_sym(uintptr_t a, char* buf, size_t cap)
+{
+    Dl_info di;
+    if (dladdr((void*)a, &di) && di.dli_sname) {
+        snprintf(buf, cap, "%s", di.dli_sname);
+        char* p = strchr(buf, '(');   /* C++: drop the argument list */
+        if (p) *p = 0;
+    } else snprintf(buf, cap, "0x%llx", (unsigned long long)a);
+    return buf;
+}
+
+static int ss_cmp(const void* a, const void* b)
+{
+    const ss_stack* x = (const ss_stack*)a; const ss_stack* y = (const ss_stack*)b;
+    return (int)y->count - (int)x->count;
+}
+
+/* Is this pc a wait in the kernel (the thread was blocked, not working)? */
+static int ss_is_wait(uintptr_t pc)
+{
+    char sym[256];
+    ss_sym(pc, sym, sizeof sym);
+    return strstr(sym, "cvwait") || strstr(sym, "semwait") || strstr(sym, "ulock_wait") ||
+           strstr(sym, "mach_msg") || strstr(sym, "workq_kernreturn") || strstr(sym, "semaphore_wait") ||
+           strstr(sym, "semaphore_timedwait") || strstr(sym, "__select") || strstr(sym, "kevent") ||
+           strstr(sym, "nanosleep") || strstr(sym, "psynch_mutexwait") || strstr(sym, "swtch_pri");
+}
+
+static void ss_report(double ms, double t0, unsigned samples)
+{
+    fprintf(stderr, "[stall] %.0f ms without a flip (t=%.3f s), %u samples\n", ms, t0, samples);
+    qsort(s_st, (size_t)s_nst, sizeof s_st[0], ss_cmp);
+    /* Per thread: the share of samples it was running (not blocked in the
+     * kernel), then its most frequent stack, then -- when it was running --
+     * the functions its running samples were in most. */
+    for (int ti = 0; ti < s_ntid; ti++) {
+        const unsigned tot = s_samples_per_tid[ti];
+        if (!tot) continue;
+        unsigned run = 0;
+        struct { uintptr_t pc; unsigned n; } top[64]; int ntop = 0;
+        const ss_stack* first = NULL;
+        for (int i = 0; i < s_nst; i++) {
+            const ss_stack* st = &s_st[i];
+            if (st->tid != s_tids[ti]) continue;
+            if (!first) first = st;
+            if (ss_is_wait(st->pc[0])) continue;
+            run += st->count;
+            /* the innermost frames only: the outer ones are in every sample */
+            for (int k = 0; k < st->n && k < 4; k++) {
+                int j = 0;
+                while (j < ntop && top[j].pc != st->pc[k]) j++;
+                if (j == ntop && ntop < 64) { top[ntop].pc = st->pc[k]; top[ntop].n = 0; ntop++; }
+                if (j < ntop) top[j].n += st->count;
+            }
+        }
+        const int busy = run * 10u >= tot;          /* running 10% of the stall or more */
+        if (!busy && first && first->count * 2u < tot) continue;   /* idle, no dominant wait: skip */
+        char line[1400]; size_t o = 0; char sym[256];
+        if (first)
+            for (int k = 0; k < first->n && o < sizeof line - 80; k++)
+                o += (size_t)snprintf(line + o, sizeof line - o, "%s%s", k ? " < " : "",
+                                      ss_sym(first->pc[k], sym, sizeof sym));
+        fprintf(stderr, "[stall]   %-30s run %3u%%  top %3u%%  %s\n", s_tnames[ti][0] ? s_tnames[ti] : "(unnamed)",
+                100u * run / tot, first ? 100u * first->count / tot : 0u, line);
+        if (busy) {
+            /* frames that appear in the most running samples (inclusive), deepest first */
+            for (int pass = 0; pass < 6 && ntop; pass++) {
+                int best = -1;
+                for (int j = 0; j < ntop; j++) if (top[j].n && (best < 0 || top[j].n > top[best].n)) best = j;
+                if (best < 0) break;
+                fprintf(stderr, "[stall]       %3u%% %s\n", 100u * top[best].n / tot, ss_sym(top[best].pc, sym, sizeof sym));
+                top[best].n = 0;
+            }
+        }
+    }
+    fflush(stderr);
+}
+
+static void* ss_thread(void* arg)
+{
+    const double limit = (double)(uintptr_t)arg / 1000.0;
+    pthread_setname_np("ps3_stall_sampler");
+    const thread_act_t self = mach_thread_self();
+    const double start = ss_now();
+    unsigned last = cellGcm_flip_request_count();
+    double last_t = ss_now();
+    for (;;) {
+        usleep(2000);
+        const unsigned f = cellGcm_flip_request_count();
+        const double now = ss_now();
+        if (f != last) { last = f; last_t = now; continue; }
+        if (!f || now - last_t < limit) continue;           /* nothing drawn yet, or no stall */
+        /* Stalled: sample until a flip comes, at most 5 s. */
+        s_nst = 0; s_ntid = 0;
+        unsigned samples = 0;
+        const double s0 = last_t;
+        while (cellGcm_flip_request_count() == last && ss_now() - s0 < 5.0) {
+            thread_act_array_t th; mach_msg_type_number_t nth = 0;
+            if (task_threads(mach_task_self(), &th, &nth) == KERN_SUCCESS) {
+                for (mach_msg_type_number_t i = 0; i < nth; i++) {
+                    if (th[i] != self) ss_sample_thread(th[i]);
+                    mach_port_deallocate(mach_task_self(), th[i]);
+                }
+                vm_deallocate(mach_task_self(), (vm_address_t)th, nth * sizeof(thread_act_t));
+            }
+            samples++;
+            usleep(5000);
+        }
+        const double end = ss_now();
+        ss_report((end - s0) * 1000.0, s0 - start, samples);
+        last = cellGcm_flip_request_count(); last_t = ss_now();
+    }
+    return NULL;
+}
+
+void ps3_stall_sampler_start(void)
+{
+    static int started;
+    const char* e = getenv("PS3_STALL_SAMPLE");
+    if (started || !e || atoi(e) <= 0) return;
+    started = 1;
+    pthread_t t;
+    if (pthread_create(&t, NULL, ss_thread, (void*)(uintptr_t)atoi(e)) == 0) {
+        pthread_detach(t);
+        fprintf(stderr, "[stall] sampler on: stacks of every thread after %d ms without a flip\n", atoi(e));
+    }
+}
+#else
+void ps3_stall_sampler_start(void) {}
+#endif
