+                              WS_CHILD | WS_VISIBLE, 16, 14, cw - 32, 24, hwnd, NULL, inst, NULL);
+    HWND he = CreateWindowExW(WS_EX_CLIENTEDGE, L"EDIT", s_osk_init,
