+static u32* g_vca_free[LD_VCA_CLASSES];
+static u32 g_vca_nfree[LD_VCA_CLASSES], g_vca_capfree[LD_VCA_CLASSES];
+static struct { u64 fence; u32 off; u32 cls; } g_vca_pend[LD_VCA_PENDING];
+static u32 g_vca_ph, g_vca_pt;       /* pending ring head / tail */
+static u64 g_vca_fails;
