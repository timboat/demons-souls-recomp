+{
+    static int on = -1;
+    if (on < 0) {
+        static const char* const sw[] = { "PPU_CSCHECK", "PS3_ICALL_GATE", "BCTRL_RING", "PS3_BREADCRUMB",
+            "PPU_TOCWATCH", "PS3_CALLTRACE", "PS3_CALLTRACE_LR", "PS3_CALLTRACE_TO", "PS3_CALLTRACE_FROM",
+            "PS3_CALLTRACE_R5", "FLOW_FORCE_RTCFG", "PPU_TOCFIX", "PPU_RETWATCH", "PS3_ICALL_SLOW" };
+        int ok = 1;
+        for (unsigned i = 0; i < sizeof sw / sizeof sw[0]; i++) if (getenv(sw[i])) ok = 0;
+        on = ok;
+    }
