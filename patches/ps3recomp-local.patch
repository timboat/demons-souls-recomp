+    if (size == 0 || size > 0x4000 || (size >= 16 && (size & 15)) || ((lsa ^ ea32) & 15) || ea32 < 0x10000u) return 0;
+    if ((uint64_t)(lsa & SPU_LS_MASK) + (uint64_t)size > (uint64_t)SPU_LS_SIZE) return 0;
+    if (cmd == MFC_GET_CMD && (size == 368 || (spu->image_id == 2 && lsa == 0xC00u))) return 0;
+    if (cmd == MFC_PUT_CMD && ea32 < 0x40005000u && ea32 + size > 0x40003000u) return 0;
+    if (!vm_base || (uint64_t)ea32 + (uint64_t)size > 0x100000000ull) return 0;
+    { extern uint8_t g_vm_page_bitmap[65536 / 8];
+      const uint32_t pg0 = ea32 >> 16, pg1 = (ea32 + size - 1) >> 16;
+      if (!((g_vm_page_bitmap[pg0 >> 3] >> (pg0 & 7)) & 1) || !((g_vm_page_bitmap[pg1 >> 3] >> (pg1 & 7)) & 1))
+          return 0; }
