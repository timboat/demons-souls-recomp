+ * Demon's Souls draws the movie only on game frames where this succeeds (+0x7B4
+ * in its player), so at 50/60 fps an "empty" here was a black frame 2 times in 5. */
+s32 cellSailGraphicsAdapterGetFrame(u32 pSelf, u32 pInfo)
+{
