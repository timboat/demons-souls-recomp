+/* _cellSpursLFQueuePushBody(CellSpursLFQueue* queue, const void* buffer, u32 isBlocking)
+ *
+ * The PPU end of a PPU2SPU queue whose consumers are SPU tasks running the
+ * title's own libsync pop code (Demon's Souls: the Edge zlib inflate tasks,
+ * fed one request per compressed file). Unbound, every push was dropped and
+ * those tasks waited forever -- nothing compressed was ever inflated, so its
+ * shaders reached VRAM as zeros.
+ *
+ * This is cellSyncLFQueue's push (_cellSyncLFQueueGetPushPointer +
+ * _cellSyncLFQueueCompletePushPointer, ported from RPCS3's cellSync.cpp) with
+ * libspurs' signal: a consumer that found the queue empty has registered its
+ * task id in m_hs1[], and the push wakes it in the taskset at m_eaSignal. Each
+ * compare-and-swap of the original becomes a read-modify-write under the
+ * lock-line lock, which is what the SPU's GETLLAR/PUTLLC on this line
+ * serialise against. Offsets (big-endian):
+ *   +0x00 pop1 {h1,h2,h3,h4}  +0x08 push1 {h5,h6,h7,h8} (push3 = {h5,h6})
+ *   +0x10 size  +0x14 depth  +0x18 buffer (u64)  +0x24 direction
+ *   +0x30 push2.pack  +0x32 m_hs1[15]  +0x70 eaSignal (u64) */
+static inline u32 lfq_r32(uint32_t a) { const uint8_t* p = vm_base + a; return ((u32)p[0] << 24) | ((u32)p[1] << 16) | ((u32)p[2] << 8) | p[3]; }
+
+static s32 lfq_get_push_pointer(uint32_t q, u32 isBlocking, s32* pointer)
+{
+    const s32 depth = (s32)lfq_r32(q + 0x14);
+    for (;;) {
+        spu_lockline_lock();
+        const u16 h8 = ef_r16(q + 0x0E);
+        s32 var2 = (s16)h8 - (s32)ef_r16(q + 0x00);          /* push pos - pop1.m_h1 */
+        if (var2 < 0) var2 += depth * 2;
+        if (var2 < depth) {
+            *pointer = (s16)h8;
+            ef_w16(q + 0x0E, (u16)(((s16)h8 + 1 >= depth * 2) ? 0 : h8 + 1));
+            ef_line_end(q);
+            return CELL_OK;
+        }
+        ef_line_end(q);
+        if (!isBlocking) return (s32)0x80410108;              /* CELL_SYNC_ERROR_AGAIN */
+        Sleep(0);
+    }
+}
+
+static void lfq_complete_push_pointer(uint32_t q, s32 pointer)
+{
+    const s32 depth = (s32)lfq_r32(q + 0x14);
+    u32 var6;
+    spu_lockline_lock();
+    {
+        u16 pack = ef_r16(q + 0x30);
+        const u16 h5 = ef_r16(q + 0x08), h6 = ef_r16(q + 0x0A);
+
+        s32 var1 = pointer - h5;
+        if (var1 < 0) var1 += depth * 2;
+        s32 var2 = (s32)(s16)ef_r16(q + 0x06) - (s32)ef_r16(q + 0x00);   /* pop1.m_h4 - m_h1 */
+        if (var2 < 0) var2 += depth * 2;
+
+        s32 var9_ = 15 - var1;
+        var9_ = (var9_ & 0x30) ? 0 : (1 << var9_);
+        const u32 inv = (u16)~(var9_ | h6);
+        s32 var9 = (inv ? __builtin_clz(inv) : 32) - 16;     /* leading zeros in a u16 */
+        s32 var5 = (var9 & 0x30) ? 0 : ((h6 | var9_) << var9);
+        s32 var3 = h5 + var9;
+        if (var3 >= depth * 2) var3 -= depth * 2;
+
+        s32 var4 = ((pack >> 10) & 0x1f) - ((pack >> 5) & 0x1f);
+        if (var4 < 0) var4 += 0x1e;
+
+        var6 = 0xFFFFFFFFu;
+        if (var2 + var4 <= 15 && ((pack >> 10) & 0x1f) != (pack & 0x1f)) {
+            s32 var11 = (pack >> 10) & 0x1f;
+            if (var11 >= 15) var11 -= 15;
+            u16 var12 = (pack >> 10) & 0x1f;
+            var12 = (var12 == 0x1d) ? 0 : (u16)((var12 + 1) << 10);
+            ef_w16(q + 0x30, (u16)((pack & 0x83ff) | var12));
+            var6 = ef_r16(q + 0x32 + 2u * (u32)var11);        /* m_hs1[var11]: waiting task */
+        }
+        ef_w16(q + 0x08, (u16)var3);                           /* push3.m_h5 */
+        ef_w16(q + 0x0A, (u16)var5);                           /* push3.m_h6 */
+        { static int dbg = -1; if (dbg < 0) dbg = getenv("LFQ_DBG") ? 1 : 0;
