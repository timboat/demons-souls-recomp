+ * the scan, so a memo is never newer than the table it was scanned from, and
+ * a change is seen no later than its bump -- the same window in which the
+ * unmemoized racy scan could already miss it. The memo starts with ea 0,
+ * which never reaches the lookup, so it cannot hit before its first scan. */
+/* fix 114: exported so spu_mfc_atomic (spu_channels.c) tests the memo hit inline; the miss half is
+ * spu_taskset_is_down_scan, called with the generation the caller already loaded. */
+volatile uint64_t g_spu_ts_down_gen = 0;
+SPU_THREAD_LOCAL struct spu_ts_memo g_spu_ts_memo;   /* fix 120: was three separate thread-locals */
