+/* The OSK reports its progress through the sysutil callback: LOADED when it
+ * appears, FINISHED when the user confirms, UNLOADED after UnloadAsync. A title
+ * that waits for FINISHED before it reads the text otherwise waits forever (the
+ * name entry of Demon's Souls' Create Profile screen). The callback may sit in
+ * any slot, so every slot is told, as cellNetCtl's start dialog does. */
+#define OSK_SYSUTIL_LOADED   0x0502u
+#define OSK_SYSUTIL_FINISHED 0x0503u
+#define OSK_SYSUTIL_UNLOADED 0x0504u
+#define OSK_SYSUTIL_SLOTS    4      /* CELL_SYSUTIL_MAX_CALLBACKS */
+extern void cellSysutilQueueEvent(int slot, uint32_t status, uint32_t param);
+static void osk_broadcast(uint32_t status)
+{
+    for (int slot = 0; slot < OSK_SYSUTIL_SLOTS; ++slot)
+        cellSysutilQueueEvent(slot, status, 0);
+}
