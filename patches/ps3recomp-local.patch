+            u32* load = &rsx->regs[M_VP_UPLOAD_FROM_ID >> 2];
+            const u32 pos = *load * 4 + lane;
+            if (pos < RSX_DSP_VP_WORDS) { rsx->vp[pos] = arg; rsx_dispatch_vp_generation++; }
+            if (lane == 3) (*load)++;
+            continue;
+        }
+        rsx_dispatch_method(rsx, raw, arg);
+        if (kd == 3) return k + 1;
+    }
+    return count;
+}
