+static u64 ld_vc_src_hash(const ld_vc_entry* e)
+{
+    u64 h = 0x51ED270B27F3A4C1ull;
+    for (u32 i = 0; i < e->n_ranges; i++) {
+        g_rs_src_b += e->range_n[i];
+        h = ld_vc_hash(e->range_p[i], e->range_n[i], h);
+    }
+    return h;
