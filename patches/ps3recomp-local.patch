+    int waited = 0;
+    for (u32 i = 0; i < g.n_surfaces; i++) {
+        eng_surface* s = &g.surfaces[i];
+        if (!s->handle || !s->guest_dirty) continue;
+        const u32 bpp = s->fmt == RSX_BE_FMT_R32F ? 4u
+                      : s->fmt == RSX_BE_FMT_R32G32B32A32F ? 16u : 0u;
+        if (!bpp || (u64)s->w * s->h > (u64)max_texels || s->pitch < s->w * bpp) continue;
+        const u32 row = s->w * bpp;
+        u8* rows = eng_coherence_buffer(row * s->h);
+        if (!rows) return;
+        if (!waited) { g.be->submit_and_wait(g.be->user, RSX_BE_FLUSH_GUEST_REFERENCE); waited = 1; }
+        g.be->readback(g.be->user, s->handle, 0, 0, s->w, s->h, rows, row);
