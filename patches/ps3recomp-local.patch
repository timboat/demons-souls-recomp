+        TranslateMessage(&m);
+        DispatchMessageW(&m);
+    }
+    s_osk_hwnd = NULL;
+    InterlockedExchange(&g_osk_host_window_open, 0);
+    osk_broadcast(OSK_SYSUTIL_FINISHED);
+    return 0;
+}
