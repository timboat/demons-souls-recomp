+/* An int setting: the variable, else the file's value (-1 = not there), else `def`. */
+static int pad_env_int(const char* var, int file, int def)
+{
+    const char* e = getenv(var);
+    return e && *e ? atoi(e) : file >= 0 ? file : def;
+}
